---
/*
 * Arte ambiente das laterais: campo de dots em halftone desenhado em <canvas>.
 * Os pontos são maiores na borda externa e diminuem em onda em direção ao conteúdo.
 * Interação com o scroll: o campo tem parallax (0.3x, em loop) e uma "luz" percorre a página
 * acendendo e ampliando os dots por onde passa (desce pela esquerda, sobe pela direita).
 *
 * Performance: sem máscaras CSS nem camadas compostas. Cada lateral é um canvas redesenhado no
 * máximo uma vez por frame, na posição real do scroll (sem suavização, para não parecer atraso);
 * os dots são agrupados por opacidade e preenchidos em poucos lotes. A cor vem de
 * `--color-primary`, lida uma vez por tema.
 * Com movimento reduzido (sistema ou configurações) a arte é desenhada uma vez, parada.
 * Com `data-art="off"` no <html> não é exibida nem desenhada.
 */
---

<div class="ambient" data-ambient-art aria-hidden="true">
  <canvas class="flank flank-left" data-side="left"></canvas>
  <canvas class="flank flank-right" data-side="right"></canvas>
</div>

<style>
  .ambient {
    position: fixed;
    inset: 0;
    z-index: var(--z-artwork);
    display: none;
    pointer-events: none;
    user-select: none;
  }

  /* Só existe quando cada lateral tem espaço útil (~100px) fora do container. */
  @media (min-width: 1280px) {
    .ambient {
      display: block;
    }
  }

  :global(:root[data-art='off']) .ambient {
    display: none;
  }

  @media print {
    .ambient {
      display: none !important;
    }
  }

  .flank {
    position: absolute;
    top: 0;
    width: max(0px, calc((100vw - var(--layout-max-width, 1280px)) / 2 - 1.5rem));
    max-width: 360px;
    height: 100%;
  }

  .flank-left {
    left: 0;
  }

  .flank-right {
    right: 0;
  }
</style>

<script>
  import { preferencesChangeEvent } from './preferences';

  const root = document.querySelector<HTMLElement>('[data-ambient-art]');

  if (root) {
    type Side = 'left' | 'right';
    interface Flank { side: Side; canvas: HTMLCanvasElement; ctx: CanvasRenderingContext2D; width: number; height: number; }

    const html = document.documentElement;
    const wide = window.matchMedia('(min-width: 1280px)');
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');

    // Geometria do halftone (px CSS).
    const GRID = 20;
    const WAVE = 480; // período vertical da onda; o padrão repete sem emenda
    const REACH = 360; // largura de referência da onda
    const PARALLAX = 0.3;
    const LEVELS = 12; // lotes de opacidade por quadro
    const STILL_PROGRESS = 0.25;

    const flanks: Flank[] = [];
    root.querySelectorAll<HTMLCanvasElement>('canvas[data-side]').forEach((canvas) => {
      const ctx = canvas.getContext('2d');
      if (ctx) flanks.push({ side: canvas.dataset.side === 'right' ? 'right' : 'left', canvas, ctx, width: 0, height: 0 });
    });

    const colors: Partial<Record<string, string>> = {};
    let color = 'currentColor';
    let baseAlpha = 0.2;
    let lightAlpha = 0.6;
    let scrollY = 0;
    let frame = 0;
    let listening = false;
    let sized = false;
    let documentHeight = 0;
    let themeDirty = true;

    const isActive = (): boolean => wide.matches && html.dataset.art !== 'off';
    const isStill = (): boolean => reduced.matches || html.dataset.motion === 'reduce';

    // Cor do tema em cache: getComputedStyle só na primeira vez de cada tema.
    const readTheme = (): void => {
      const theme = html.dataset.theme === 'dark' ? 'dark' : 'light';
      colors[theme] ??= getComputedStyle(html).getPropertyValue('--color-primary').trim() || color;
      color = colors[theme] ?? color;
      themeDirty = false;
      baseAlpha = theme === 'dark' ? 0.22 : 0.2;
      lightAlpha = theme === 'dark' ? 0.66 : 0.58;
    };

    // Usa os tamanhos entregues pelo ResizeObserver: nenhuma leitura de layout no frame de desenho.
    const resize = (): void => {
      const ratio = Math.min(window.devicePixelRatio || 1, 1.5);
      for (const flank of flanks) {
        flank.canvas.width = Math.round(flank.width * ratio);
        flank.canvas.height = Math.round(flank.height * ratio);
        flank.ctx.setTransform(ratio, 0, 0, ratio, 0, 0);
      }
      sized = true;
    };

    const smooth = (edge0: number, edge1: number, value: number): number => {
      const t = Math.min(1, Math.max(0, (value - edge0) / (edge1 - edge0)));
      return t * t * (3 - 2 * t);
    };

    const drawFlank = (flank: Flank, scroll: number, progress: number): void => {
      const { ctx, width, height, side } = flank;
      ctx.clearRect(0, 0, width, height);
      if (width < 40) return;

      // Lado direito começa meia onda adiante para não parecer cópia do esquerdo.
      const shift = scroll * PARALLAX + (side === 'right' ? WAVE / 2 : 0);
      const lightY = height * (side === 'left' ? 0.12 + 0.72 * progress : 0.88 - 0.72 * progress);
      const lightX = width * 0.35;
      const lightRadius = Math.max(220, width * 0.9);
      const batches = Array.from({ length: LEVELS }, () => new Path2D());

      const firstRow = Math.floor(shift / GRID);
      const lastRow = Math.ceil((shift + height) / GRID);
      for (let row = firstRow; row <= lastRow; row += 1) {
        const worldY = row * GRID + GRID / 2;
        const y = worldY - shift;
        const phase = (2 * Math.PI * worldY) / WAVE;
        const edge = REACH * (0.5 + 0.14 * Math.sin(phase) + 0.06 * Math.sin(2 * phase + 1));
        const fadeY = smooth(0.04, 0.2, y / height) * (1 - smooth(0.86, 1, y / height));
        if (fadeY <= 0) continue;

        for (let outer = GRID / 2; outer < width; outer += GRID) {
          const fadeX = 1 - smooth(0.55, 1, outer / width);
          const distance = Math.hypot(outer - lightX, y - lightY) / lightRadius;
          const lit = distance < 1 ? (1 - distance) ** 2 : 0;
          const alpha = (baseAlpha + lightAlpha * lit) * fadeX * fadeY;
          if (alpha < 0.02) continue;

          const t = Math.max(0, 1 - outer / edge);
          const radius = (0.9 + 3.4 * t ** 1.35) * (1 + 0.3 * lit);
          const x = side === 'left' ? outer : width - outer;
          const batch = batches[Math.min(LEVELS - 1, Math.floor(alpha * LEVELS))];
          if (!batch) continue;
          batch.moveTo(x + radius, y);
          batch.arc(x, y, radius, 0, Math.PI * 2);
        }
      }

      ctx.fillStyle = color;
      batches.forEach((batch, level) => {
        ctx.globalAlpha = (level + 0.5) / LEVELS;
        ctx.fill(batch);
      });
      ctx.globalAlpha = 1;
    };

    const draw = (): void => {
      const still = isStill();
      const max = documentHeight - window.innerHeight;
      const progress = still ? STILL_PROGRESS : max > 0 ? Math.min(1, Math.max(0, scrollY / max)) : 0;
      for (const flank of flanks) drawFlank(flank, still ? 0 : scrollY, progress);
    };

    // Um desenho por frame, sempre na posição real do scroll (sem suavização, sem atraso).
    const render = (): void => {
      frame = 0;
      if (themeDirty) readTheme();
      if (!sized) resize();
      scrollY = window.scrollY;
      draw();
    };

    const schedule = (): void => {
      if (!frame) frame = window.requestAnimationFrame(render);
    };

    // Tamanho dos canvas e altura rolável chegam por observação, sem forçar reflow.
    const observer = new ResizeObserver((entries) => {
      for (const entry of entries) {
        if (entry.target === html) {
          documentHeight = entry.contentRect.height;
          continue;
        }
        const flank = flanks.find((item) => item.canvas === entry.target);
        if (!flank) continue;
        flank.width = entry.contentRect.width;
        flank.height = entry.contentRect.height;
        sized = false;
      }
      if (isActive()) schedule();
    });

    const setListening = (value: boolean): void => {
      if (value === listening) return;
      listening = value;
      if (value) window.addEventListener('scroll', schedule, { passive: true });
      else window.removeEventListener('scroll', schedule);
    };

    const sync = (): void => {
      const active = isActive();
      setListening(active && !isStill());
      observer.disconnect();
      if (!active) return;
      observer.observe(html);
      for (const flank of flanks) observer.observe(flank.canvas);
      themeDirty = true;
      schedule();
    };

    wide.addEventListener('change', sync);
    reduced.addEventListener('change', sync);
    window.addEventListener(preferencesChangeEvent, sync);
    sync();
  }
</script>
