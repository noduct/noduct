---
import { LOCALES, type Locale } from '@noduct/tool-runtime';
import Icon from '../icons/Icon.astro';
import Button from '../components/Button.astro';
import Switch from '../components/Switch.astro';
import { getShellMessages } from './messages';
import popover from './Popover.module.css';
import styles from './SettingsMenu.module.css';

interface Props {
  locale: Locale;
  languageHrefs: Readonly<Record<Locale, string>>;
  showArtworkControls?: boolean;
  idPrefix: string;
}

const { locale, languageHrefs, showArtworkControls = true, idPrefix } = Astro.props;
const m = getShellMessages(locale);
// Nomes de idioma sempre no próprio idioma, para que qualquer pessoa reconheça o seu.
const languageNames: Record<Locale, string> = {
  en: 'English',
  'pt-BR': 'Português (Brasil)',
  es: 'Español'
};
const languages = LOCALES.map((code) => ({
  code,
  name: languageNames[code],
  href: languageHrefs[code]
}));
const panelId = `${idPrefix}-settings-panel`;
const titleId = `${idPrefix}-settings-title`;
---

<div class={styles.settings} data-settings data-locale={locale}>
  <Button
    variant="secondary"
    iconOnly
    class={styles.trigger}
    ariaLabel={m.settings.open}
    title={m.settings.title}
    ariaExpanded="false"
    ariaControls={panelId}
    data-settings-trigger
  >
    <Icon class={styles.gear} name="settings" />
  </Button>

  <div
    id={panelId}
    class:list={[popover.panel, styles.panel]}
    role="dialog"
    aria-labelledby={titleId}
    data-settings-panel
    hidden
  >
    <div class={popover.header}>
      <h2 id={titleId} class={popover.title}>{m.settings.title}</h2>
    </div>

    <div class={styles.body}>
      <!-- SEÇÃO 1: APARÊNCIA E EXIBIÇÃO (INSET CARD) -->
      <section class={styles.section} aria-label={m.settings.theme}>
        <span class={styles.sectionTitle}>{m.settings.theme}</span>
        <div class={styles.insetCard}>
          <!-- Linha de Tema: Rótulo à esquerda, controle segmentado compacto à direita -->
          <fieldset class={styles.row}>
            <legend class={styles.srOnly}>{m.settings.theme}</legend>
            <span class={styles.rowLabel} aria-hidden="true">{m.settings.theme}</span>
            <div class={styles.segmented} role="radiogroup" aria-label={m.settings.theme}>
              <label class={styles.segment}>
                <input type="radio" name="settings-theme" value="light" checked data-pref-theme />
                <Icon class={styles.segmentIcon} name="sun" />
                <span>{m.settings.light}</span>
              </label>
              <label class={styles.segment}>
                <input type="radio" name="settings-theme" value="dark" data-pref-theme />
                <Icon class={styles.segmentIcon} name="moon" />
                <span>{m.settings.dark}</span>
              </label>
            </div>
          </fieldset>

          {showArtworkControls && (
            <div class:list={[styles.row, styles.artworkRow]}>
              <div class={styles.optionText}>
                <span id="settings-art-label" class={styles.rowLabel}>{m.settings.artwork}</span>
                <span id="settings-art-hint" class={styles.hint}>{m.settings.artworkHint}</span>
              </div>
              <Switch
                checked={true}
                ariaLabelledby="settings-art-label"
                ariaDescribedby="settings-art-hint"
                data-pref-art
              />
            </div>
          )}

          {showArtworkControls && (
            <div class:list={[styles.row, styles.artworkRow]}>
              <div class={styles.optionText}>
                <span id="settings-motion-label" class={styles.rowLabel}>{m.settings.motion}</span>
                <span id="settings-motion-hint" class={styles.hint}>{m.settings.motionHint}</span>
              </div>
              <Switch
                checked={false}
                ariaLabelledby="settings-motion-label"
                ariaDescribedby="settings-motion-hint"
                data-pref-motion
              />
            </div>
          )}
        </div>
      </section>

      <!-- SEÇÃO 2: IDIOMA E REGIÃO (INSET CARD) -->
      <section class={styles.section} aria-labelledby="settings-language-label">
        <span id="settings-language-label" class={styles.sectionTitle}>{m.settings.language}</span>
        <div class={styles.insetCard}>
          <ul class={styles.languages} role="list">
            <li class={styles.languageItem}>
              <button
                class={styles.language}
                type="button"
                aria-pressed="true"
                data-pref-locale="auto"
              >
                <span class={styles.languageText}>
                  <span class={styles.languageName}>{m.settings.automatic}</span>
                  <span class={styles.hint}>{m.settings.automaticHint}</span>
                </span>
                <Icon class={styles.check} name="check" />
              </button>
            </li>
            {languages.map((language) => (
              <li class={styles.languageItem}>
                <a
                  class={styles.language}
                  href={language.href}
                  hreflang={language.code}
                  lang={language.code}
                  aria-current={language.code === locale ? 'page' : undefined}
                  data-pref-locale={language.code}
                >
                  <span class={styles.languageText}>
                    <span class={styles.languageName}>{language.name}</span>
                  </span>
                  <Icon class={styles.check} name="check" />
                </a>
              </li>
            ))}
          </ul>
        </div>
      </section>
    </div>
  </div>
</div>

<script>
  import { isLocale, resolveBrowserLocale, topology } from '@noduct/tool-runtime';
  import {
    preferenceKeys,
    readPreference,
    setPreference,
    writePreference
  } from './preferences';

  const root = document.querySelector<HTMLElement>('[data-settings]');
  const trigger = root?.querySelector<HTMLButtonElement>('[data-settings-trigger]');
  const panel = root?.querySelector<HTMLElement>('[data-settings-panel]');

  if (root && trigger && panel) {
    const html = document.documentElement;
    const themeInputs = root.querySelectorAll<HTMLInputElement>('[data-pref-theme]');
    const artSwitch = root.querySelector<HTMLButtonElement>('[data-pref-art]');
    const motionSwitch = root.querySelector<HTMLButtonElement>('[data-pref-motion]');
    const languageOptions = root.querySelectorAll<HTMLElement>('[data-pref-locale]');

    // Reflete no painel o estado já aplicado ao <html> pelo script do <head>.
    const render = (): void => {
      const theme = html.dataset.theme === 'dark' ? 'dark' : 'light';
      themeInputs.forEach((input) => {
        input.checked = input.value === theme;
      });
      const artworkEnabled = html.dataset.art !== 'off';
      artSwitch?.setAttribute('aria-checked', String(artworkEnabled));
      const motionChecked = artworkEnabled && html.dataset.motion === 'reduce';
      motionSwitch?.setAttribute('aria-checked', String(motionChecked));
      if (motionSwitch) {
        motionSwitch.disabled = !artworkEnabled;
        if (!artworkEnabled) {
          motionSwitch.setAttribute('aria-disabled', 'true');
          motionSwitch.setAttribute('data-blocked', 'true');
        } else {
          motionSwitch.removeAttribute('aria-disabled');
          motionSwitch.removeAttribute('data-blocked');
        }
      }
      const saved = readPreference(preferenceKeys.locale);
      const selected = saved && isLocale(saved) ? saved : 'auto';
      languageOptions.forEach((option) => {
        option.dataset.selected = String(option.dataset.prefLocale === selected);
        if (option instanceof HTMLButtonElement)
          option.setAttribute('aria-pressed', String(selected === 'auto'));
      });
    };

    const update = (key: string, value: string | null): void => {
      setPreference(key, value);
      render();
    };

    const open = (): void => {
      render();
      panel.hidden = false;
      trigger.setAttribute('aria-expanded', 'true');
      root.querySelector<HTMLInputElement>('[data-pref-theme]:checked')?.focus();
    };

    const close = (restoreFocus = false): void => {
      if (panel.hidden) return;
      panel.hidden = true;
      trigger.setAttribute('aria-expanded', 'false');
      if (restoreFocus) trigger.focus();
    };

    trigger.addEventListener('click', () => (panel.hidden ? open() : close()));

    themeInputs.forEach((input) =>
      input.addEventListener('change', () => update(preferenceKeys.theme, input.value))
    );
    artSwitch?.addEventListener('click', () =>
      update(preferenceKeys.art, html.dataset.art === 'off' ? null : 'off')
    );
    motionSwitch?.addEventListener('click', () => {
      if (
        html.dataset.art === 'off' ||
        motionSwitch.disabled ||
        motionSwitch.getAttribute('aria-disabled') === 'true' ||
        motionSwitch.dataset.blocked === 'true'
      ) {
        return;
      }
      update(preferenceKeys.motion, html.dataset.motion === 'reduce' ? null : 'reduce');
    });
    render();

    languageOptions.forEach((option) => {
      option.addEventListener('click', (event) => {
        const choice = option.dataset.prefLocale ?? 'auto';
        if (choice !== 'auto') {
          writePreference(preferenceKeys.locale, choice);
          return; // O link segue para a página no idioma escolhido.
        }
        event.preventDefault();
        writePreference(preferenceKeys.locale, null);
        const target = resolveBrowserLocale(
          navigator.languages?.length ? navigator.languages : [navigator.language]
        );
        if (target !== root.dataset.locale)
          window.location.assign(topology.scopePath(topology.parse(window.location.pathname)?.scope ?? { kind: 'hub' }, '', target));
        else render();
      });
    });

    document.addEventListener('click', (event) => {
      if (!root.contains(event.target as Node)) close();
    });
    root.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') close(true);
    });
    root.addEventListener('focusout', (event) => {
      if (event.relatedTarget instanceof Node && !root.contains(event.relatedTarget)) close();
    });
  }

  const recentSection = document.querySelector<HTMLElement>('[data-recent-section]');
  const recentItems = [...document.querySelectorAll<HTMLElement>('[data-recent-tool]')];
  const readRecent = (): string[] => {
    try {
      const value: unknown = JSON.parse(readPreference(preferenceKeys.recentTools) ?? '[]');
      return Array.isArray(value) ? value.filter((item): item is string => typeof item === 'string') : [];
    } catch {
      return [];
    }
  };
  const renderRecent = (): void => {
    const ordered = readRecent()
      .map((id) => recentItems.find((item) => item.dataset.recentTool === id))
      .filter((item): item is HTMLElement => item !== undefined)
      .slice(0, 3);
    recentItems.forEach((item) => { item.hidden = true; });
    ordered.forEach((item) => { item.hidden = false; item.parentElement?.append(item); });
    if (recentSection) recentSection.hidden = ordered.length === 0;
  };
  document.addEventListener('click', (event) => {
    const target = event.target instanceof Element ? event.target.closest<HTMLElement>('[data-recent-id]') : null;
    const id = target?.dataset.recentId;
    if (id) writePreference(preferenceKeys.recentTools, JSON.stringify([id, ...readRecent().filter((item) => item !== id)].slice(0, 6)));
  });
  document.querySelector('[data-clear-recent]')?.addEventListener('click', () => {
    writePreference(preferenceKeys.recentTools, null);
    renderRecent();
  });
  renderRecent();
</script>
