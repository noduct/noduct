---
import styles from './WorkspaceLoading.module.css';
import { WORKSPACE_VIEW_KEY } from '../workspace-ui/view-preference';

interface Props {
  variant: 'recents' | 'manager';
  label: string;
}

const { variant, label } = Astro.props;
// Mesmo número de botões de ícone do item real, para a linha de ações ter a largura final.
const actionCount = variant === 'manager' ? 4 : 3;
---

<div class={styles.root} data-workspace-loading data-variant={variant} data-view="list">
  {variant === 'manager' && (
    <script is:inline define:vars={{ viewKey: WORKSPACE_VIEW_KEY }}>
      try {
        const loading = document.currentScript?.parentElement;
        if (loading && localStorage.getItem(viewKey) === 'grid') loading.dataset.view = 'grid';
      } catch {
        // Sem armazenamento, a lista continua sendo a visualização inicial.
      }
    </script>
  )}
  <span class="sr-only" role="status">{label}</span>
  <div class={styles.items} aria-hidden="true">
    {Array.from({ length: 3 }, () => (
      <div class={styles.item}>
        {variant === 'manager' && <span class={styles.check}></span>}
        <span class={styles.thumb}></span>
        <span class={styles.copy}>
          <span class={styles.name}></span>
          <span class={styles.line}></span>
          <span class={styles.short}></span>
          {variant === 'manager' && <span class={styles.badge}></span>}
        </span>
        <span class={styles.actions}>
          {Array.from({ length: actionCount }, () => <span></span>)}
        </span>
      </div>
    ))}
  </div>
</div>
