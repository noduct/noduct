---
interface Props {
  orientation?: 'vertical' | 'horizontal' | 'both';
  maxHeight?: string;
  maxWidth?: string;
  mask?: boolean;
  class?: string;
}

const {
  orientation = 'vertical',
  maxHeight,
  maxWidth,
  mask = false,
  class: className = ''
} = Astro.props;
---

<div
  class:list={['scroll-area', `scroll-${orientation}`, { 'has-mask': mask }, className]}
  style={{
    ...(maxHeight ? { '--scroll-max-height': maxHeight } : {}),
    ...(maxWidth ? { '--scroll-max-width': maxWidth } : {})
  }}
>
  <div class="scroll-viewport">
    <slot />
  </div>
</div>

<style>
  .scroll-area {
    position: relative;
    display: flex;
    flex-direction: column;
    max-height: var(--scroll-max-height, 100%);
    max-width: var(--scroll-max-width, 100%);
    overflow: hidden;
  }

  .scroll-viewport {
    width: 100%;
    height: 100%;
    overflow-y: hidden;
    overflow-x: hidden;
    overscroll-behavior: contain;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: thin;
    scrollbar-color: var(--scrollbar-thumb) transparent;
  }

  .scroll-vertical .scroll-viewport {
    overflow-y: auto;
  }

  .scroll-horizontal .scroll-viewport {
    overflow-x: auto;
  }

  .scroll-both .scroll-viewport {
    overflow-y: auto;
    overflow-x: auto;
  }

  /* Custom Sleek Scrollbar */
  .scroll-viewport::-webkit-scrollbar {
    width: var(--scrollbar-width, 7px);
    height: var(--scrollbar-width, 7px);
    background-color: transparent;
  }

  .scroll-viewport::-webkit-scrollbar-track {
    background-color: transparent;
  }

  .scroll-viewport::-webkit-scrollbar-thumb {
    background-color: var(--scrollbar-thumb);
    border-radius: var(--radius-pill);
    border: 2px solid transparent;
    background-clip: padding-box;
    transition: background-color var(--duration-fast) var(--ease-apple);
  }

  .scroll-viewport::-webkit-scrollbar-thumb:hover {
    background-color: var(--scrollbar-thumb-hover);
    background-clip: padding-box;
  }

  .scroll-viewport::-webkit-scrollbar-corner {
    background-color: transparent;
  }

  /* Máscara opcional com fade suave estilo Apple */
  .has-mask.scroll-vertical {
    mask-image: linear-gradient(
      to bottom,
      transparent 0,
      var(--color-mask-opaque) 16px,
      var(--color-mask-opaque) calc(100% - 16px),
      transparent 100%
    );
    -webkit-mask-image: linear-gradient(
      to bottom,
      transparent 0,
      var(--color-mask-opaque) 16px,
      var(--color-mask-opaque) calc(100% - 16px),
      transparent 100%
    );
  }

  .has-mask.scroll-horizontal {
    mask-image: linear-gradient(
      to right,
      transparent 0,
      var(--color-mask-opaque) 16px,
      var(--color-mask-opaque) calc(100% - 16px),
      transparent 100%
    );
    -webkit-mask-image: linear-gradient(
      to right,
      transparent 0,
      var(--color-mask-opaque) 16px,
      var(--color-mask-opaque) calc(100% - 16px),
      transparent 100%
    );
  }
</style>
