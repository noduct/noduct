---
import Icon from '../icons/Icon.astro';
import type { HTMLAttributes } from 'astro/types';
import type { IconName } from '../icons/registry';
import styles from './Button.module.css';

export interface Props {
  variant?: 'primary' | 'secondary' | 'quiet' | 'danger' | 'danger-quiet' | undefined;
  size?: 'sm' | 'md' | 'lg' | undefined;
  iconOnly?: boolean | undefined;
  type?: 'button' | 'submit' | 'reset' | undefined;
  href?: string | undefined;
  icon?: IconName | undefined;
  iconTrailing?: IconName | undefined;
  disabled?: boolean | undefined;
  id?: string | undefined;
  class?: string | undefined;
  title?: string | undefined;
  ariaLabel?: string | undefined;
  ariaControls?: string | undefined;
  ariaExpanded?: boolean | 'true' | 'false' | undefined;
  ariaPressed?: boolean | 'true' | 'false' | undefined;
  ariaDescribedby?: string | undefined;
  ariaHaspopup?:
    | boolean
    | 'true'
    | 'false'
    | 'menu'
    | 'listbox'
    | 'tree'
    | 'grid'
    | 'dialog'
    | undefined;
  ariaCurrent?: 'page' | 'step' | 'location' | 'date' | 'time' | 'true' | 'false' | boolean | undefined;
  ariaBusy?: boolean | 'true' | 'false' | undefined;
  role?: HTMLAttributes<'button'>['role'];
  target?: string | undefined;
  rel?: string | undefined;
  download?: string | boolean | undefined;
  hidden?: boolean | undefined;
  [key: `data-${string}`]: unknown;
}

const {
  variant = 'primary',
  size = 'md',
  iconOnly = false,
  type = 'button',
  href,
  icon,
  iconTrailing,
  disabled = false,
  id,
  class: className,
  title,
  ariaLabel,
  ariaControls,
  ariaExpanded,
  ariaPressed,
  ariaDescribedby,
  ariaHaspopup,
  ariaCurrent,
  ariaBusy,
  role,
  target,
  rel,
  download,
  hidden = false,
  ...rest
} = Astro.props;

const classes = [
  styles.button,
  styles[variant],
  styles[size],
  iconOnly && styles.iconOnly,
  className
];
---

{
  href ? (
    <a
      id={id}
      href={disabled ? undefined : href}
      aria-disabled={disabled ? 'true' : undefined}
      tabindex={disabled ? -1 : undefined}
      title={title}
      aria-label={ariaLabel}
      aria-controls={ariaControls}
      aria-expanded={ariaExpanded}
      aria-pressed={ariaPressed}
      aria-describedby={ariaDescribedby}
      aria-haspopup={ariaHaspopup}
      aria-current={ariaCurrent}
      aria-busy={ariaBusy}
      role={role}
      target={target}
      rel={rel}
      download={download === true ? '' : download || undefined}
      hidden={hidden || undefined}
      class:list={classes}
      {...rest}
    >
      {icon && <Icon name={icon} class={iconOnly ? styles.iconGlyph : styles.iconLeading} />}
      <slot />
      {iconTrailing && <Icon name={iconTrailing} class={styles.iconTrailing} />}
    </a>
  ) : (
    <button
      id={id}
      type={type}
      disabled={disabled || undefined}
      title={title}
      aria-label={ariaLabel}
      aria-controls={ariaControls}
      aria-expanded={ariaExpanded}
      aria-pressed={ariaPressed}
      aria-describedby={ariaDescribedby}
      aria-haspopup={ariaHaspopup}
      aria-current={ariaCurrent}
      aria-busy={ariaBusy}
      role={role}
      hidden={hidden || undefined}
      class:list={classes}
      {...rest}
    >
      {icon && <Icon name={icon} class={iconOnly ? styles.iconGlyph : styles.iconLeading} />}
      <slot />
      {iconTrailing && <Icon name={iconTrailing} class={styles.iconTrailing} />}
    </button>
  )
}
