---
import SponsorCard from './SponsorCard.astro';
import type { SponsorCampaign } from '../sponsorship/contracts';
import type { DesignLocale } from '../i18n';
// Deprecated import path. Use SponsorCard or SponsorshipSlot with the v1 contract.
interface Props {
  sponsor?: SponsorCampaign;
  locale?: DesignLocale;
}
const { sponsor, locale = 'en' } = Astro.props;
---

{sponsor && <SponsorCard campaign={sponsor} locale={locale} />}
