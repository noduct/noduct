{
  "extends": "astro/tsconfigs/strictest",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@noduct/design-system": [
        "../design-system/src/index.ts"
      ],
      "@noduct/design-system/*": [
        "../design-system/*"
      ],
      "@noduct/tool-runtime": [
        "../tool-runtime/src/index.ts"
      ]
    }
  },
  "include": [
    ".astro/types.d.ts",
    "**/*"
  ],
  "exclude": [
    "dist"
  ]
}
