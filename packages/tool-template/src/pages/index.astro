---
import SeoHead from '@tolvira/design-system/components/SeoHead.astro';
import ToolFrame from '@tolvira/design-system/components/ToolFrame.astro';
import SponsoredPlacement from '@tolvira/design-system/components/SponsoredPlacement.astro';
import { toolConfig } from '../config';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <SeoHead title={`${toolConfig.name} | Tolvira template`} description={toolConfig.description} canonical={toolConfig.canonicalUrl} noindex={!toolConfig.published} />
  </head>
  <body>
    <ToolFrame>
      <nav class="crumbs" aria-label="Breadcrumb"><a href="https://tolvira.github.io/">Tolvira</a> / <a href={toolConfig.category.url}>{toolConfig.category.name}</a> / <span aria-current="page">{toolConfig.name}</span></nav>
      <h1>{toolConfig.name}</h1><p>{toolConfig.description}</p>
      <section class="tool" aria-labelledby="tool-title"><h2 id="tool-title">Clean up text</h2><label for="source">Text to clean</label><textarea id="source" placeholder="Paste text with extra spaces or blank lines"></textarea><div class="actions"><button id="process" type="button">Clean text</button><button id="clear" class="secondary" type="button">Clear</button></div><p class="notice">{toolConfig.privacyNotice}</p><div class="result" id="result" role="status" aria-live="polite" hidden></div></section>
      <SponsoredPlacement />
      <section><h2>How it works</h2><ol><li>Paste text into the field.</li><li>Select <strong>Clean text</strong>.</li><li>Copy the normalized result.</li></ol></section>
      <section><h2>Limitations</h2><p>This demonstration removes repeated horizontal spaces and reduces three or more line breaks to two. It does not analyze meaning or grammar.</p></section>
      <section><h2>Related tools</h2><p>Related links appear here only after those applications are published.</p></section>
    </ToolFrame>
    <script>
      import { cleanText } from '../lib/clean-text';
      const source = document.querySelector('#source'); const result = document.querySelector('#result');
      document.querySelector('#process')?.addEventListener('click', () => { if (!(source instanceof HTMLTextAreaElement) || !(result instanceof HTMLElement)) return; result.textContent = cleanText(source.value) || 'Enter some text first.'; result.hidden = false; });
      document.querySelector('#clear')?.addEventListener('click', () => { if (source instanceof HTMLTextAreaElement) source.value = ''; if (result instanceof HTMLElement) { result.textContent = ''; result.hidden = true; } if (source instanceof HTMLElement) source.focus(); });
    </script>
  </body>
</html>
<style>
  .crumbs{margin:2rem 0 1rem;font-size:.9rem;color:var(--color-text-secondary)}.crumbs a{color:inherit}h1{font-size:clamp(2rem,6vw,3.5rem);line-height:1.1}.tool{margin:2rem 0;padding:1.25rem;border:1px solid var(--color-border);border-radius:var(--radius-lg);background:var(--color-surface)}textarea{width:100%;min-height:180px;padding:1rem;border:1px solid var(--color-border);border-radius:var(--radius-md);color:inherit;background:var(--color-background)}.actions{display:flex;gap:.75rem;margin-top:.75rem}button{min-height:44px;padding:.6rem 1rem;border:0;border-radius:var(--radius-md);background:var(--color-primary);color:#fff;font-weight:700;cursor:pointer}button.secondary{border:1px solid var(--color-border);background:var(--color-background);color:var(--color-text)}.notice{color:var(--color-text-secondary);font-size:.9rem}.result{margin-top:1rem;padding:1rem;border-left:4px solid var(--color-primary);background:var(--color-background)}section{margin:2.5rem 0}
</style>
