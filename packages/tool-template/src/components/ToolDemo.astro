---
import AppShell from '@noduct/design-system/shell/AppShell.astro';
import ToolPage from '@noduct/design-system/shell/ToolPage.astro';
import WorkspaceDrawer from '@noduct/design-system/components/WorkspaceDrawer.astro';
import { toolJsonLd } from '@noduct/design-system/shell/tool-page';
import type { Locale } from '@noduct/tool-runtime';
import { tool } from '../config';
import { toolMessages } from '../i18n';
import styles from './ToolDemo.module.css';

const { locale } = Astro.props as { locale: Locale };
const m = toolMessages[locale];
const jsonLd = toolJsonLd(tool, locale, { name: m.name, description: m.description });
---

<AppShell
  scope={tool.scope}
  {locale}
  title={m.name}
  description={m.description}
  noindex={!tool.published}
  {jsonLd}
>
  <WorkspaceDrawer id="tool-workspace-drawer" locale={locale} slot="actions" />
  <ToolPage {tool} {locale} heading={m.name} lede={m.description}>
    <section class={styles.workspace} aria-labelledby="tool-title">
      <h2 id="tool-title">{m.toolTitle}</h2>
      <label for="source">{m.label}</label>
      <textarea id="source" placeholder={m.placeholder}></textarea>
      <div class={styles.actions}>
        <button id="process" type="button">{m.process}</button>
        <button id="clear" class={styles.secondary} type="button">{m.clear}</button>
      </div>
      <p class={styles.notice}>{m.privacy}</p>
      <div
        class={styles.result}
        id="result"
        role="status"
        aria-live="polite"
        data-empty-message={m.empty}
        hidden
      >
      </div>
    </section>

    <Fragment slot="content">
      <section class={styles.info}>
        <h2>{m.howTitle}</h2>
        <ol>{m.how.map((item) => <li>{item}</li>)}</ol>
      </section>
      <section class={styles.info}>
        <h2>{m.limitsTitle}</h2>
        <p>{m.limits}</p>
      </section>
      <section class={styles.info}>
        <h2>{m.relatedTitle}</h2>
        <p>{m.related}</p>
      </section>
    </Fragment>

    <script>
      import { cleanText } from '../lib/clean-text';
      import { workspaceErrorMessages } from '../i18n';
      import { connectWorkspaceDrawer } from '@noduct/design-system/workspace-ui';
      import {
        openWorkspace,
        DEFAULT_DOCUMENT_MAX_IDLE_MS,
        detectDeviceProfile,
        DESKTOP_RESOURCE_BUDGET,
        MOBILE_RESOURCE_BUDGET
      } from '@noduct/workspace-core';
      const language = document.documentElement.lang;
      const locale = language === 'pt-BR' || language === 'es' ? language : 'en';
      const workspaceRoot = document.querySelector<HTMLElement>('[data-workspace-root]');
      if (workspaceRoot) {
        let clientPromise: ReturnType<typeof openWorkspace> | undefined;
        const getClient = () => (clientPromise ??= openWorkspace());
        const disconnect = connectWorkspaceDrawer(workspaceRoot, getClient, {
          maxIdleMs: DEFAULT_DOCUMENT_MAX_IDLE_MS,
          limitBytes: () =>
            (detectDeviceProfile() === 'mobile' ? MOBILE_RESOURCE_BUDGET : DESKTOP_RESOURCE_BUDGET)
              .maxWorkspaceStorageBytes,
          formatError: () => workspaceErrorMessages[locale]
        });
        window.addEventListener(
          'pagehide',
          () => {
            disconnect();
            void clientPromise?.then((client) => client.close());
          },
          { once: true }
        );
      }
      const source = document.querySelector<HTMLTextAreaElement>('#source');
      const result = document.querySelector<HTMLElement>('#result');
      document.querySelector('#process')?.addEventListener('click', () => {
        if (!source || !result) return;
        result.textContent = cleanText(source.value) || result.dataset.emptyMessage || '';
        result.hidden = false;
      });
      document.querySelector('#clear')?.addEventListener('click', () => {
        if (source) source.value = '';
        if (result) {
          result.textContent = '';
          result.hidden = true;
        }
        source?.focus();
      });
    </script>
  </ToolPage>
</AppShell>
