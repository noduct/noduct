---
import AppShell from '@noduct/design-system/shell/AppShell.astro';
import ToolPage from '@noduct/design-system/shell/ToolPage.astro';
import DropZone from '@noduct/design-system/components/DropZone.astro';
import DownloadCard from '@noduct/design-system/components/DownloadCard.astro';
import Button from '@noduct/design-system/components/Button.astro';
import { toolJsonLd } from '@noduct/design-system/shell/tool-page';
import type { Locale } from '@noduct/tool-runtime';
import { tool } from '../config';
import { toolMessages } from '../i18n';
import styles from './ToolDemo.module.css';

const { locale } = Astro.props as { locale: Locale };
const m = toolMessages[locale];
const jsonLd = toolJsonLd(tool, locale, { name: m.name, description: m.description });
---

<AppShell
  scope={tool.scope}
  {locale}
  title={m.name}
  description={m.description}
  noindex={!tool.published}
  {jsonLd}
>
  <ToolPage {tool} {locale} heading={m.name} lede={m.description}>
    <section class={styles.workspace} aria-labelledby="tool-title">
      <h2 id="tool-title">{m.toolTitle}</h2>
      {/* Padrão híbrido (ADR 0006): duas origens de entrada e salvar resultado como opt-in. */}
      <DropZone
        id="tool-source-file"
        label={m.dropLabel}
        description={m.dropDescription}
        accept="text/plain,.txt"
        multiple={false}
        {locale}
        workspace={{ confirmLabel: m.useFile }}
      />
      <label for="source">{m.label}</label>
      <textarea id="source" placeholder={m.placeholder}></textarea>
      <div class={styles.actions}>
        <Button id="process" variant="primary">{m.process}</Button>
        <Button id="clear" variant="secondary">{m.clear}</Button>
      </div>
      <p class={styles.notice}>{m.privacy}</p>
      <div
        class={styles.result}
        id="result"
        role="status"
        aria-live="polite"
        data-empty-message={m.empty}
        hidden
      >
      </div>
      <DownloadCard
        id="tool-download"
        title={m.downloadTitle}
        fileName={m.resultFileName}
        hidden={true}
        {locale}
        workspace={{ sourceTool: tool.slug }}
      />
    </section>

    <Fragment slot="content">
      <section class={styles.info}>
        <h2>{m.howTitle}</h2>
        <ol>{m.how.map((item) => <li>{item}</li>)}</ol>
      </section>
      <section class={styles.info}>
        <h2>{m.limitsTitle}</h2>
        <p>{m.limits}</p>
      </section>
      <section class={styles.info}>
        <h2>{m.relatedTitle}</h2>
        <p>{m.related}</p>
      </section>
    </Fragment>

    <script>
      import { cleanText } from '../lib/clean-text';
      import {
        FILES_SELECTED_EVENT,
        getDownloadCard,
        RESTART_EVENT,
        type FilesSelectedDetail
      } from '@noduct/design-system/file-workflow';
      import {
        connectLocalWorkspace,
        createWorkspaceServices
      } from '@noduct/design-system/workspace-ui';

      // Uma linha liga seletor, salvar resultado e prévias; ferramentas de PDF passam também
      // `loadRenderer: () => import('@noduct/pdf-core/render')` para ter miniaturas.
      connectLocalWorkspace(
        document,
        createWorkspaceServices({ loadWorkspace: () => import('@noduct/workspace-core') })
      );

      const source = document.querySelector<HTMLTextAreaElement>('#source');
      const result = document.querySelector<HTMLElement>('#result');
      const cardElement = document.querySelector<HTMLElement>('[data-download-card]');
      const card = cardElement ? getDownloadCard(cardElement) : undefined;
      const fileName = cardElement?.querySelector('[data-download-name]')?.textContent ?? '';

      // Arquivos do dispositivo e da Área Local chegam pelo mesmo evento.
      document.addEventListener(FILES_SELECTED_EVENT, async (event) => {
        const [file] = (event as CustomEvent<FilesSelectedDetail>).detail.accepted;
        if (file && source) source.value = await file.text();
      });
      document.querySelector('#process')?.addEventListener('click', () => {
        if (!source || !result) return;
        const cleaned = cleanText(source.value);
        result.textContent = cleaned || result.dataset.emptyMessage || '';
        result.hidden = false;
        if (cleaned) card?.show({ file: new Blob([cleaned], { type: 'text/plain' }), fileName });
        else card?.reset();
      });
      const clear = () => {
        if (source) source.value = '';
        if (result) {
          result.textContent = '';
          result.hidden = true;
        }
        card?.reset();
        source?.focus();
      };
      document.querySelector('#clear')?.addEventListener('click', clear);
      document.addEventListener(RESTART_EVENT, clear);
    </script>
  </ToolPage>
</AppShell>
