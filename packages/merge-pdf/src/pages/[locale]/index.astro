---
import MergePdfApp from '../../components/MergePdfApp.astro';
import type { DesignLocale } from '@noduct/design-system';

export function getStaticPaths() {
  return [
    { params: { locale: 'pt-br' }, props: { locale: 'pt-BR' } },
    { params: { locale: 'es' }, props: { locale: 'es' } }
  ];
}

const { locale } = Astro.props as { locale: DesignLocale };
---

<MergePdfApp locale={locale} />

