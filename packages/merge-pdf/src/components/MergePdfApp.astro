---
import AppShell from '@noduct/design-system/shell/AppShell.astro';
import ToolPage from '@noduct/design-system/shell/ToolPage.astro';
import { toolBreadcrumbItems } from '@noduct/design-system/shell/tool-page';
import DropZone from '@noduct/design-system/components/DropZone.astro';
import ReorderableList from '@noduct/design-system/components/ReorderableList.astro';
import ProcessingFeedback from '@noduct/design-system/components/ProcessingFeedback.astro';
import DownloadCard from '@noduct/design-system/components/DownloadCard.astro';
import WorkspaceDrawer from '@noduct/design-system/components/WorkspaceDrawer.astro';
import Icon from '@noduct/design-system/icons/Icon.astro';
import type { Locale } from '@noduct/tool-runtime';
import { breadcrumbList, jsonLdGraph, softwareApplication, topology } from '@noduct/tool-runtime';
import { tool } from '../config';
import { mergeMessages } from '../i18n';
import type { MergeClientMessages } from '../i18n';
import styles from './MergePdfApp.module.css';

interface Props {
  locale?: Locale;
}

const { locale = 'en' } = Astro.props;
const m = mergeMessages[locale];
const jsonLd = jsonLdGraph([
  softwareApplication({
    name: m.name,
    description: m.description,
    url: topology.canonical(tool.scope, '', locale),
    locale
  }),
  breadcrumbList(toolBreadcrumbItems(tool, locale, m.name))
]);
const clientMessages = {
  minFilesRequired: m.minFilesRequired,
  oneFileReady: m.oneFileReady,
  filesReady: m.filesReady,
  remove: m.remove,
  removeFile: m.removeFile,
  errorEncrypted: m.errorEncrypted,
  errorCorrupted: m.errorCorrupted,
  statusValidating: m.statusValidating,
  statusMerging: m.statusMerging,
  statusSaving: m.statusSaving
} satisfies MergeClientMessages;
---

<AppShell
  scope={tool.scope}
  {locale}
  title={m.name}
  description={m.description}
  noindex={!tool.published}
  {jsonLd}
>
  <WorkspaceDrawer id="merge-workspace-drawer" locale={locale} slot="actions" />
  <ToolPage {tool} {locale} heading={m.name} lede={m.description}>
    <section class={styles.workspace} aria-label={m.name}>
      <DropZone
        id="merge-drop-zone"
        label={m.dropLabel}
        description={m.dropDescription}
        multiple={true}
        locale={locale}
      />

      <div id="merge-alerts" class={styles.alerts} role="alert" hidden data-merge-alerts></div>
      <p class={styles.alerts} role="alert" hidden data-budget-alert></p>

      <ReorderableList id="merge-file-list" label={m.listLabel} locale={locale} />

      <div class={styles.controlsBar}>
        <p id="merge-file-count" class={styles.statusText} data-merge-count>
          {m.minFilesRequired}
        </p>
        <div class={styles.actions}>
          <button
            id="clear-all-btn"
            type="button"
            class={styles.clearButton}
            hidden
            data-action="clear"
          >
            {m.clear}
          </button>
          <button
            id="start-merge-btn"
            type="button"
            class={styles.mergeButton}
            disabled
            data-action="merge"
          >
            {m.actionMerge}
          </button>
        </div>
      </div>

      <ProcessingFeedback
        label={m.processingLabel}
        status={m.statusValidating}
        cancellable={true}
        hidden={true}
        locale={locale}
      />

      <DownloadCard
        id="merge-download-card"
        title={m.downloadTitle}
        fileName={m.downloadFileName}
        hidden={true}
        locale={locale}
      />

      <p class={styles.privacyNotice}>
        <Icon name="lock" aria-hidden="true" />
        {m.privacyNotice}
      </p>
    </section>

    <Fragment slot="content">
      <section class={styles.infoSection}>
        <h2>{m.howTitle}</h2>
        <ol>
          {m.how.map((step) => <li>{step}</li>)}
        </ol>
      </section>

      <section class={styles.infoSection}>
        <h2>{m.limitsTitle}</h2>
        <p>{m.limits}</p>
      </section>

      <section class={styles.infoSection}>
        <h2>{m.securityTitle}</h2>
        <p>{m.security}</p>
      </section>
    </Fragment>
    <script
      type="application/json"
      id="merge-messages"
      set:html={JSON.stringify(clientMessages).replace(/</g, '\\u003c')}
    />
    <script>
      import type { MergeClientMessages } from '../i18n';
      import clientStyles from './MergePdfApp.module.css';
      import type { Locale } from '@noduct/tool-runtime';
      import {
        CANCEL_EVENT,
        FILES_SELECTED_EVENT,
        LIST_CHANGE_EVENT,
        RESTART_EVENT,
        getDownloadCard,
        getDropZone,
        getProcessingFeedback,
        getReorderableList,
        type FilesSelectedDetail,
        type ListChangeDetail
      } from '@noduct/design-system/file-workflow';
      import {
        getWorkspaceDrawer,
        WORKSPACE_ACTION_EVENT,
        WORKSPACE_OPEN_EVENT,
        type WorkspaceActionDetail
      } from '@noduct/design-system/workspace-ui';
      import type { MergeWorkflow, WorkflowFileItem } from '../lib/merge-workflow';
      import type { WorkspaceClient } from '@noduct/workspace-core';
      import { formatBudgetIssue } from '../lib/workspace-budget-messages';
      import { formatWorkspaceError } from '../lib/workspace-error-messages';

      const language = document.documentElement.lang;
      const clientLocale: Locale = language === 'pt-BR' || language === 'es' ? language : 'en';
      const messageNode = document.querySelector<HTMLScriptElement>('#merge-messages');
      if (!messageNode?.textContent) throw new Error('Missing localized merge messages');
      const messages = JSON.parse(messageNode.textContent) as MergeClientMessages;
      const numberFormat = new Intl.NumberFormat(clientLocale);
      const formatMessage = (template: string, values: Record<string, string>) =>
        template.replace(/\{(name|files|pages)\}/g, (_, key: string) => values[key] ?? '');

      let workspacePromise: Promise<WorkspaceClient> | undefined;
      function getLocalWorkspace(): Promise<WorkspaceClient> {
        if (!workspacePromise) {
          workspacePromise = import('@noduct/workspace-core')
            .then(({ openWorkspace }) => openWorkspace())
            .catch((error: unknown) => {
              workspacePromise = undefined;
              throw error;
            });
        }
        return workspacePromise;
      }
      window.addEventListener('pagehide', () => {
        void workspacePromise?.then((workspace) => workspace.close());
      });

      // Lazy load workflow module to optimize LCP < 1.5s
      let workflowPromise: Promise<MergeWorkflow> | undefined;
      function getWorkflow(): Promise<MergeWorkflow> {
        if (!workflowPromise) {
          workflowPromise = import('../lib/merge-workflow').then((mod) => {
            const wf = new mod.MergeWorkflow();
            wf.subscribe(() => updateUI(wf));
            return wf;
          });
        }
        return workflowPromise;
      }

      const dropZoneEl = document.querySelector<HTMLElement>('[data-drop-zone]')!;
      const listEl = document.querySelector<HTMLElement>('[data-reorderable-list]')!;
      const feedbackEl = document.querySelector<HTMLElement>('[data-processing-feedback]')!;
      const downloadEl = document.querySelector<HTMLElement>('[data-download-card]')!;
      const alertsEl = document.querySelector<HTMLElement>('[data-merge-alerts]')!;
      const budgetAlertEl = document.querySelector<HTMLElement>('[data-budget-alert]')!;
      const countEl = document.querySelector<HTMLElement>('[data-merge-count]')!;
      const mergeBtn = document.querySelector<HTMLButtonElement>('[data-action="merge"]')!;
      const clearBtn = document.querySelector<HTMLButtonElement>('[data-action="clear"]')!;

      const dropZone = getDropZone(dropZoneEl)!;
      const reorderList = getReorderableList(listEl)!;
      const feedback = getProcessingFeedback(feedbackEl)!;
      const downloadCard = getDownloadCard(downloadEl)!;

      function renderAlerts(items: readonly WorkflowFileItem[], workflow: MergeWorkflow) {
        const invalid = items.filter((i) => i.status !== 'valid');
        if (invalid.length === 0) {
          alertsEl.replaceChildren();
          alertsEl.hidden = true;
          return;
        }

        alertsEl.hidden = false;
        alertsEl.replaceChildren(
          ...invalid.map((item) => {
            const div = document.createElement('div');
            div.className = clientStyles.alertItem!;
            div.setAttribute('data-alert-item', item.id);

            const msg = document.createElement('span');
            msg.textContent =
              item.status === 'encrypted'
                ? formatMessage(messages.errorEncrypted, { name: item.name })
                : formatMessage(messages.errorCorrupted, { name: item.name });

            const btn = document.createElement('button');
            btn.type = 'button';
            btn.textContent = messages.remove;
            btn.setAttribute('aria-label', formatMessage(messages.removeFile, { name: item.name }));
            btn.className = clientStyles.alertDismiss!;
            btn.addEventListener('click', () => {
              workflow.removeItem(item.id);
            });

            div.append(msg, btn);
            return div;
          })
        );
      }

      function updateUI(workflow: MergeWorkflow) {
        const state = workflow.getState();
        const validItems = state.items.filter((i) => i.status === 'valid');

        reorderList.setItems(validItems);
        renderAlerts(state.items, workflow);

        mergeBtn.disabled = !state.canMerge;
        clearBtn.hidden = state.items.length === 0;

        if (validItems.length === 0) {
          countEl.textContent = messages.minFilesRequired;
        } else if (validItems.length === 1) {
          countEl.textContent = messages.oneFileReady;
        } else {
          countEl.textContent = formatMessage(messages.filesReady, {
            files: numberFormat.format(validItems.length),
            pages: numberFormat.format(state.totalPages)
          });
        }
      }

      document.addEventListener(FILES_SELECTED_EVENT, async (event) => {
        const detail = (event as CustomEvent<FilesSelectedDetail>).detail;
        if (!detail.accepted.length) return;
        const workflow = await getWorkflow();
        await workflow.addFiles(detail.accepted);
        updateUI(workflow);
      });

      document.addEventListener(LIST_CHANGE_EVENT, async (event) => {
        const detail = (event as CustomEvent<ListChangeDetail>).detail;
        const workflow = await getWorkflow();
        if (detail.action === 'move') {
          workflow.reorder(detail.ids);
        } else if (detail.action === 'remove') {
          workflow.removeItem(detail.id);
        }
        updateUI(workflow);
      });

      mergeBtn.addEventListener('click', async () => {
        const workflow = await getWorkflow();
        if (!workflow.getState().canMerge) return;

        const { evaluateResourceBudget } = await import('@noduct/workspace-core');
        const validItems = workflow.getState().items.filter((item) => item.status === 'valid');
        const assessment = await evaluateResourceBudget({
          inputs: validItems.map((item) => ({
            name: item.name,
            size: item.size,
            pageCount: item.pageCount
          }))
        });
        budgetAlertEl.hidden = true;
        if (assessment.decision === 'blocked') {
          budgetAlertEl.textContent = formatBudgetIssue(assessment, clientLocale);
          budgetAlertEl.hidden = false;
          return;
        }
        if (
          assessment.decision === 'warning' &&
          !window.confirm(formatBudgetIssue(assessment, clientLocale))
        )
          return;

        dropZone.setDisabled(true);
        mergeBtn.disabled = true;
        clearBtn.hidden = true;
        feedbackEl.hidden = false;
        downloadCard.reset();

        feedback.update({ status: messages.statusValidating, value: 0 });

        try {
          const testDelay = (window as unknown as { __MERGE_STEP_DELAY_MS__?: number })
            .__MERGE_STEP_DELAY_MS__;
          const result = await workflow.executeMerge({
            stepDelayMs: testDelay,
            onProgress: ({ phase, percent }) => {
              const statusText =
                phase === 'loading'
                  ? messages.statusValidating
                  : phase === 'processing'
                    ? messages.statusMerging
                    : messages.statusSaving;
              feedback.update({ status: statusText, value: percent });
            }
          });

          feedbackEl.hidden = true;
          dropZone.setDisabled(false);
          downloadCard.show({ file: result.blob, fileName: result.fileName });

          try {
            const ws = await getLocalWorkspace();
            await ws.saveDocument({
              name: result.fileName,
              mimeType: 'application/pdf',
              blob: result.blob,
              size: result.blob.size,
              sourceTool: 'merge-pdf',
              metadata: { toolSource: 'merge-pdf' }
            });
          } catch {
            // Gracefully ignore local workspace save errors if storage is unavailable
          }
        } catch {
          feedbackEl.hidden = true;
          dropZone.setDisabled(false);
          updateUI(workflow);
        }
      });

      document.addEventListener(CANCEL_EVENT, async () => {
        const workflow = await getWorkflow();
        workflow.cancel();
        feedbackEl.hidden = true;
        dropZone.setDisabled(false);
        updateUI(workflow);
      });

      function handleReset(workflow: MergeWorkflow) {
        workflow.reset();
        feedbackEl.hidden = true;
        downloadCard.reset();
        dropZone.setDisabled(false);
        alertsEl.replaceChildren();
        alertsEl.hidden = true;
        budgetAlertEl.hidden = true;
        updateUI(workflow);
        document.querySelector<HTMLInputElement>('#merge-drop-zone')?.focus();
      }

      clearBtn.addEventListener('click', async () => {
        const workflow = await getWorkflow();
        handleReset(workflow);
      });

      document.addEventListener(RESTART_EVENT, async () => {
        const workflow = await getWorkflow();
        handleReset(workflow);
      });

      const workspaceRoot = document.querySelector<HTMLElement>('[data-workspace-root]');
      if (workspaceRoot) {
        const drawer = getWorkspaceDrawer(workspaceRoot);
        let initialCleanupAnnounced = false;
        let subscribed = false;

        async function syncWorkspace() {
          try {
            const {
              DEFAULT_DOCUMENT_MAX_IDLE_MS,
              detectDeviceProfile,
              DESKTOP_RESOURCE_BUDGET,
              MOBILE_RESOURCE_BUDGET
            } = await import('@noduct/workspace-core');
            const ws = await getLocalWorkspace();
            const removedOnOpen = initialCleanupAnnounced ? 0 : ws.initialCleanupRemovedIds.length;
            initialCleanupAnnounced = true;
            const removedNow = await ws.cleanupExpiredDocuments();
            drawer?.announceExpired(removedOnOpen + removedNow.length);
            if (!subscribed) {
              ws.subscribe((event) => {
                if (
                  event.type === 'document_deleted' &&
                  event.reason === 'expired' &&
                  drawer?.isOpen()
                ) {
                  drawer.announceExpired(1);
                }
                if (drawer?.isOpen()) void syncWorkspace();
              });
              subscribed = true;
            }
            const docs = await ws.listDocuments();
            const size = await ws.getWorkspaceSize();
            drawer?.setItems(
              docs.map((d) => ({
                id: d.id,
                name: d.name,
                size: d.size,
                createdAt: d.createdAt,
                retention: d.retention,
                lastAccessedAt: d.lastAccessedAt
              })),
              size.totalBytes,
              (detectDeviceProfile() === 'mobile'
                ? MOBILE_RESOURCE_BUDGET
                : DESKTOP_RESOURCE_BUDGET
              ).maxWorkspaceStorageBytes,
              DEFAULT_DOCUMENT_MAX_IDLE_MS
            );
          } catch (error) {
            drawer?.announceError(formatWorkspaceError(error, clientLocale));
          }
        }

        document.addEventListener(WORKSPACE_OPEN_EVENT, () => {
          syncWorkspace();
        });

        document.addEventListener(WORKSPACE_ACTION_EVENT, async (event) => {
          const detail = (event as CustomEvent<WorkspaceActionDetail>).detail;
          try {
            const ws = await getLocalWorkspace();
            if (detail.action === 'clear-all') {
              await ws.clearDocuments();
              await syncWorkspace();
            } else if (detail.action === 'delete') {
              await ws.deleteDocument(detail.documentId);
              await syncWorkspace();
            } else if (detail.action === 'set-retention') {
              await ws.setRetention(detail.documentId, detail.retention);
              await syncWorkspace();
            } else if (detail.action === 'download') {
              const doc = await ws.getDocument(detail.documentId);
              if (doc) {
                const url = URL.createObjectURL(doc.blob);
                const a = document.createElement('a');
                a.href = url;
                a.download = doc.name;
                document.body.appendChild(a);
                a.click();
                a.remove();
                URL.revokeObjectURL(url);
                await syncWorkspace();
              }
            }
          } catch (error) {
            drawer?.announceError(formatWorkspaceError(error, clientLocale));
          }
        });
      }
    </script>
  </ToolPage>
</AppShell>
