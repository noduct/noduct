---
import SeoHead from '@noduct/design-system/components/SeoHead.astro';
import ToolFrame from '@noduct/design-system/components/ToolFrame.astro';
import DropZone from '@noduct/design-system/components/DropZone.astro';
import ReorderableList from '@noduct/design-system/components/ReorderableList.astro';
import ProcessingFeedback from '@noduct/design-system/components/ProcessingFeedback.astro';
import DownloadCard from '@noduct/design-system/components/DownloadCard.astro';
import SponsorshipSlot from '@noduct/design-system/components/SponsorshipSlot.astro';
import type { DesignLocale } from '@noduct/design-system';
import { toolConfig } from '../config';
import { mergeMessages } from '../i18n';
import styles from './MergePdfApp.module.css';

interface Props {
  locale?: DesignLocale;
}

const { locale = 'en' } = Astro.props;
const m = mergeMessages[locale];
const prefix = locale === 'en' ? '' : locale === 'pt-BR' ? 'pt-br/' : 'es/';
const canonicalUrl = `${toolConfig.canonicalUrl}${prefix}`;
const hubUrl = `https://noduct.github.io/${prefix}`;

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'SoftwareApplication',
      name: m.name,
      description: m.description,
      applicationCategory: 'UtilityApplication',
      operatingSystem: 'Any',
      offers: {
        '@type': 'Offer',
        price: '0',
        priceCurrency: 'USD'
      }
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        {
          '@type': 'ListItem',
          position: 1,
          name: 'Noduct',
          item: hubUrl
        },
        {
          '@type': 'ListItem',
          position: 2,
          name: m.category,
          item: `${hubUrl}pdf-tools/`
        },
        {
          '@type': 'ListItem',
          position: 3,
          name: m.name,
          item: canonicalUrl
        }
      ]
    }
  ]
};
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <SeoHead
      title={`${m.name} | Noduct`}
      description={m.description}
      canonical={canonicalUrl}
      noindex={!toolConfig.published}
    />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <ToolFrame hubUrl={hubUrl} locale={locale}>
      <nav class={styles.crumbs} aria-label={m.breadcrumb}>
        <a href={hubUrl}>Noduct</a> /
        <a href={`${hubUrl}pdf-tools/`}>{m.category}</a> /
        <span aria-current="page">{m.name}</span>
      </nav>

      <h1 class={styles.title}>{m.name}</h1>
      <p class={styles.lead}>{m.description}</p>

      <section class={styles.workspace} aria-label={m.name}>
        <DropZone
          id="merge-drop-zone"
          label={m.dropLabel}
          description={m.dropDescription}
          multiple={true}
          locale={locale}
        />

        <div id="merge-alerts" class={styles.alerts} role="alert" hidden data-merge-alerts></div>

        <ReorderableList id="merge-file-list" label={m.listLabel} locale={locale} />

        <div class={styles.controlsBar}>
          <p id="merge-file-count" class={styles.statusText} data-merge-count>
            {m.minFilesRequired}
          </p>
          <div class={styles.actions}>
            <button
              id="clear-all-btn"
              type="button"
              class={styles.clearButton}
              hidden
              data-action="clear"
            >
              Clear
            </button>
            <button
              id="start-merge-btn"
              type="button"
              class={styles.mergeButton}
              disabled
              data-action="merge"
            >
              {m.actionMerge}
            </button>
          </div>
        </div>

        <ProcessingFeedback
          label={m.processingLabel}
          status={m.statusValidating}
          cancellable={true}
          hidden={true}
          locale={locale}
        />

        <DownloadCard
          id="merge-download-card"
          title={m.downloadTitle}
          fileName={m.downloadFileName}
          hidden={true}
          locale={locale}
        />

        <p class={styles.privacyNotice}>
          <span aria-hidden="true">🔒</span>
          {m.privacyNotice}
        </p>
      </section>

      <SponsorshipSlot
        placementId={toolConfig.sponsorPlacementId}
        registryUrl={toolConfig.sponsorshipRegistryUrl}
        enabled={toolConfig.sponsorshipEnabled}
        locale={locale}
      />

      <section class={styles.infoSection}>
        <h2>{m.howTitle}</h2>
        <ol>
          {m.how.map((step) => <li>{step}</li>)}
        </ol>
      </section>

      <section class={styles.infoSection}>
        <h2>{m.limitsTitle}</h2>
        <p>{m.limits}</p>
      </section>

      <section class={styles.infoSection}>
        <h2>{m.securityTitle}</h2>
        <p>{m.security}</p>
      </section>
    </ToolFrame>

    <script>
      import {
        CANCEL_EVENT,
        FILES_SELECTED_EVENT,
        LIST_CHANGE_EVENT,
        RESTART_EVENT,
        getDownloadCard,
        getDropZone,
        getProcessingFeedback,
        getReorderableList,
        type FilesSelectedDetail,
        type ListChangeDetail
      } from '@noduct/design-system/file-workflow';
      import type { MergeWorkflow, WorkflowFileItem } from '../lib/merge-workflow';

      // Lazy load workflow module to optimize LCP < 1.5s
      let workflowPromise: Promise<MergeWorkflow> | undefined;
      function getWorkflow(): Promise<MergeWorkflow> {
        if (!workflowPromise) {
          workflowPromise = import('../lib/merge-workflow').then((mod) => {
            const wf = new mod.MergeWorkflow();
            wf.subscribe(() => updateUI(wf));
            return wf;
          });
        }
        return workflowPromise;
      }

      const dropZoneEl = document.querySelector<HTMLElement>('[data-drop-zone]')!;
      const listEl = document.querySelector<HTMLElement>('[data-reorderable-list]')!;
      const feedbackEl = document.querySelector<HTMLElement>('[data-processing-feedback]')!;
      const downloadEl = document.querySelector<HTMLElement>('[data-download-card]')!;
      const alertsEl = document.querySelector<HTMLElement>('[data-merge-alerts]')!;
      const countEl = document.querySelector<HTMLElement>('[data-merge-count]')!;
      const mergeBtn = document.querySelector<HTMLButtonElement>('[data-action="merge"]')!;
      const clearBtn = document.querySelector<HTMLButtonElement>('[data-action="clear"]')!;

      const dropZone = getDropZone(dropZoneEl)!;
      const reorderList = getReorderableList(listEl)!;
      const feedback = getProcessingFeedback(feedbackEl)!;
      const downloadCard = getDownloadCard(downloadEl)!;

      function renderAlerts(items: readonly WorkflowFileItem[], workflow: MergeWorkflow) {
        const invalid = items.filter((i) => i.status !== 'valid');
        if (invalid.length === 0) {
          alertsEl.replaceChildren();
          alertsEl.hidden = true;
          return;
        }

        alertsEl.hidden = false;
        alertsEl.replaceChildren(
          ...invalid.map((item) => {
            const div = document.createElement('div');
            div.className = '_alertItem_1k021_31'; // fallback class or dataset
            div.setAttribute('data-alert-item', item.id);

            const msg = document.createElement('span');
            msg.textContent =
              item.status === 'encrypted'
                ? `"${item.name}" is password-protected and cannot be processed.`
                : `"${item.name}" is corrupted or not a valid PDF.`;

            const btn = document.createElement('button');
            btn.type = 'button';
            btn.textContent = 'Remove';
            btn.setAttribute('aria-label', `Remove ${item.name}`);
            btn.className = '_alertDismiss_1k021_43';
            btn.addEventListener('click', () => {
              workflow.removeItem(item.id);
            });

            div.append(msg, btn);
            return div;
          })
        );
      }

      function updateUI(workflow: MergeWorkflow) {
        const state = workflow.getState();
        const validItems = state.items.filter((i) => i.status === 'valid');

        reorderList.setItems(validItems);
        renderAlerts(state.items, workflow);

        mergeBtn.disabled = !state.canMerge;
        clearBtn.hidden = state.items.length === 0;

        if (validItems.length === 0) {
          countEl.textContent = 'Select at least 2 PDF files to merge.';
        } else if (validItems.length === 1) {
          countEl.textContent = '1 valid PDF selected (select at least 1 more to merge).';
        } else {
          countEl.textContent = `${validItems.length} PDFs ready to merge (${state.totalPages} total pages).`;
        }
      }

      document.addEventListener(FILES_SELECTED_EVENT, async (event) => {
        const detail = (event as CustomEvent<FilesSelectedDetail>).detail;
        if (!detail.accepted.length) return;
        const workflow = await getWorkflow();
        await workflow.addFiles(detail.accepted);
        updateUI(workflow);
      });

      document.addEventListener(LIST_CHANGE_EVENT, async (event) => {
        const detail = (event as CustomEvent<ListChangeDetail>).detail;
        const workflow = await getWorkflow();
        if (detail.action === 'move') {
          workflow.reorder(detail.ids);
        } else if (detail.action === 'remove') {
          workflow.removeItem(detail.id);
        }
        updateUI(workflow);
      });

      mergeBtn.addEventListener('click', async () => {
        const workflow = await getWorkflow();
        if (!workflow.getState().canMerge) return;

        dropZone.setDisabled(true);
        mergeBtn.disabled = true;
        clearBtn.hidden = true;
        feedbackEl.hidden = false;
        downloadCard.reset();

        feedback.update({ status: 'Starting PDF merge...', value: 0 });

        try {
          const testDelay = (window as unknown as { __MERGE_STEP_DELAY_MS__?: number })
            .__MERGE_STEP_DELAY_MS__;
          const result = await workflow.executeMerge({
            stepDelayMs: testDelay,
            onProgress: ({ phase, percent }) => {
              const statusText =
                phase === 'loading'
                  ? 'Loading PDF files...'
                  : phase === 'processing'
                    ? 'Combining pages into unified document...'
                    : 'Saving final PDF document...';
              feedback.update({ status: statusText, value: percent });
            }
          });

          feedbackEl.hidden = true;
          dropZone.setDisabled(false);
          downloadCard.show({ file: result.blob, fileName: result.fileName });
        } catch {
          feedbackEl.hidden = true;
          dropZone.setDisabled(false);
          updateUI(workflow);
        }
      });

      document.addEventListener(CANCEL_EVENT, async () => {
        const workflow = await getWorkflow();
        workflow.cancel();
        feedbackEl.hidden = true;
        dropZone.setDisabled(false);
        updateUI(workflow);
      });

      function handleReset(workflow: MergeWorkflow) {
        workflow.reset();
        feedbackEl.hidden = true;
        downloadCard.reset();
        dropZone.setDisabled(false);
        alertsEl.replaceChildren();
        alertsEl.hidden = true;
        updateUI(workflow);
        document.querySelector<HTMLInputElement>('#merge-drop-zone')?.focus();
      }

      clearBtn.addEventListener('click', async () => {
        const workflow = await getWorkflow();
        handleReset(workflow);
      });

      document.addEventListener(RESTART_EVENT, async () => {
        const workflow = await getWorkflow();
        handleReset(workflow);
      });
    </script>
  </body>
</html>
