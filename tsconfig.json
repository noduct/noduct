{
  "extends": "astro/tsconfigs/strictest",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@noduct/design-system": ["packages/design-system/src/index.ts"],
      "@noduct/design-system/*": ["packages/design-system/*"]
    },
    "noUncheckedIndexedAccess": true
  },
  "include": [".astro/types.d.ts", "**/*"],
  "exclude": ["dist", "node_modules", ".sponsorship-fixture", "tests/fixtures/sponsorship-app/.astro"]
}
