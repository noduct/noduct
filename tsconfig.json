{
  "extends": "astro/tsconfigs/strictest",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@noduct/design-system": ["packages/design-system/src/index.ts"],
      "@noduct/design-system/*": ["packages/design-system/*"],
      "@noduct/pdf-core": ["packages/pdf-core/src/index.ts"],
      "@noduct/workspace-core": ["packages/workspace-core/src/index.ts"],
      "@noduct/tool-runtime": ["packages/tool-runtime/src/index.ts"]
    },
    "noUncheckedIndexedAccess": true
  },
  "include": [".astro/types.d.ts", "**/*"],
  "exclude": ["dist", "dist-pages", "**/dist/**", "node_modules", ".sponsorship-fixture", "tests/fixtures/sponsorship-app/.astro", "packages/merge-pdf/.astro"]
}
