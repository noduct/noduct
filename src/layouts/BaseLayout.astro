---
import AppShell from '@noduct/design-system/shell/AppShell.astro';
import { HUB_SCOPE, organization, topology } from '@noduct/tool-runtime';
import { siteConfig } from '@/config/site';
import { getMessages } from '@/i18n/messages';
import { getValidatedSupportUrl } from '@/lib/support';
import type { Locale } from '@/i18n/config';

interface Props {
  title: string;
  description: string;
  image?: string;
  noindex?: boolean;
  locale?: Locale;
  /** Caminho do hub da página. Obrigatório quando a URL pedida não é a da página (404). */
  path?: string;
}

const { title, description, image, noindex = false, locale = 'en' } = Astro.props;
const parsed = topology.parse(Astro.url.pathname);
const path = Astro.props.path ?? (parsed?.scope.kind === 'hub' ? parsed.path : '');
// A URL de apoio passa pela validação estrita (host, HTTPS, sem credenciais nem parâmetros).
const supportUrl = getValidatedSupportUrl(siteConfig.support) ?? undefined;
const imageAlt = getMessages(locale).home.badge;
---

<AppShell
  variant="page"
  scope={HUB_SCOPE}
  {locale}
  {path}
  {title}
  {description}
  {image}
  {imageAlt}
  {noindex}
  {supportUrl}
  jsonLd={{ '@context': 'https://schema.org', '@graph': [organization()] }}
  redirectLocale={locale === 'en'}
>
  <slot />
</AppShell>
