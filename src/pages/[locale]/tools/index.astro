---
import DirectoryPage from '@/components/pages/DirectoryPage.astro';
import type { Locale } from '@/i18n/config';
export function getStaticPaths() { return [{ params: { locale: 'pt-br' }, props: { locale: 'pt-BR' } }, { params: { locale: 'es' }, props: { locale: 'es' } }]; }
const { locale } = Astro.props as { locale: Locale };
---
<DirectoryPage locale={locale} />
