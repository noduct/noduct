---
import HubLayout from '@/layouts/HubLayout.astro';
import ToolSearch from '@/components/tools/ToolSearch.astro';
import ToolCard from '@/components/tools/ToolCard.astro';
import { categories } from '@/data/categories';
import { featuredTools, tools } from '@/data/tools';
---
<HubLayout title="Free Online Tools for PDF, Images & More | Tolvira" description="Discover free online tools to edit PDFs, convert images, format data and simplify everyday tasks. Fast, simple and easy to use.">
  <section class="hero">
    <div class="container hero-inner">
      <p class="eyebrow">Fast. Private. Focused.</p>
      <h1>Free Online Tools for Everyday Tasks</h1>
      <p class="lede">Simple, fast and free tools for PDFs, images, text, data and more. No sign-up required.</p>
      <ToolSearch tools={tools} compact={true} />
      <p class="availability">The first tools are in development. Planned tools are clearly labeled until their applications are published.</p>
    </div>
  </section>
  <section class="section container" aria-labelledby="available-title">
    <div class="section-heading"><div><p class="eyebrow">Available now</p><h2 id="available-title">Published tools</h2></div><a href="/tools/">Browse the roadmap →</a></div>
    {featuredTools.length ? <div class="grid grid-3">{featuredTools.map((tool) => <ToolCard tool={tool} />)}</div> : <div class="surface empty"><strong>No tools are published yet.</strong><p>We are building the foundation first. Explore the roadmap to see what is planned.</p><a class="button secondary" href="/tools/">View tool roadmap</a></div>}
  </section>
  <section class="section category-section">
    <div class="container"><p class="eyebrow">Explore</p><h2>Tools by category</h2><p class="lede">A focused collection organized around the task you want to complete.</p>
      <div class="grid grid-3 category-grid">{categories.map((category) => <a class="card category-card" href={`/${category.id}/`}><span class="category-icon" aria-hidden="true">{category.name.slice(0, 1)}</span><div><h3>{category.name}</h3><p>{category.description}</p><small>{tools.filter((tool) => tool.category === category.id).length} planned tools</small></div></a>)}</div>
    </div>
  </section>
  <section class="section container principles"><div><p class="eyebrow">Built differently</p><h2>Useful tools without the usual friction</h2></div><div class="grid grid-3"><article><h3>No account required</h3><p>Open a tool and get the task done without creating a profile.</p></article><article><h3>Privacy by design</h3><p>Tools favor local browser processing and must state clearly when data leaves your device.</p></article><article><h3>Lightweight by default</h3><p>Static pages, minimal JavaScript and focused interfaces keep the experience responsive.</p></article></div></section>
</HubLayout>
<style>
  .hero { padding-block: clamp(4rem, 10vw, 7.5rem); background: var(--color-surface); border-bottom: 1px solid var(--color-border); }
  .hero-inner { max-width: 900px; text-align: center; } .hero h1, .hero .lede { margin-inline: auto; }
  .hero :global(.search) { max-width: 720px; margin-inline: auto; text-align: left; }
  .availability { margin-top: 1rem; color: var(--color-text-secondary); font-size: .85rem; }
  .section-heading { display: flex; align-items: end; justify-content: space-between; gap: 1rem; margin-bottom: 1.5rem; }
  .empty strong { color: var(--color-text); font-size: 1.15rem; } .empty .button { margin-top: 1rem; }
  .category-section { background: var(--color-surface); border-block: 1px solid var(--color-border); }
  .category-grid { margin-top: 2rem; } .category-card { display: flex; gap: 1rem; }
  .category-icon { display: grid; flex: 0 0 auto; width: 42px; height: 42px; place-items: center; border-radius: var(--radius-md); background: var(--color-primary-soft); color: var(--color-primary-strong); font-weight: 800; }
  .category-card p { margin-top: .3rem; } .category-card small { color: var(--color-text-secondary); }
  .principles { display: grid; grid-template-columns: .8fr 1.7fr; gap: 3rem; } .principles article { padding-top: 1rem; border-top: 2px solid var(--color-border); }
  @media(max-width: 760px) { .section-heading, .principles { display: grid; } }
</style>
