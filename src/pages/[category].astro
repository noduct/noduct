---
import CategoryPage from '@/components/pages/CategoryPage.astro';
import { categories } from '@/data/categories';
export function getStaticPaths() { return categories.map((category) => ({ params: { category: category.id }, props: { categoryId: category.id } })); }
const { categoryId } = Astro.props;
---
<CategoryPage locale="en" categoryId={categoryId} />
