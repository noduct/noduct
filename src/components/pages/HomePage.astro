---
import HubLayout from '@/layouts/HubLayout.astro';
import Icon from '@noduct/design-system/icons/Icon.astro';
import Button from '@noduct/design-system/components/Button.astro';
import ToolSearch from '@/components/tools/ToolSearch.astro';
import ToolCard from '@/components/tools/ToolCard.astro';
import ToolIcon from '@/components/tools/ToolIcon.astro';
import RecentTools from '@/components/tools/RecentTools.astro';
import WorkspaceHomeSection from '@/components/workspace/WorkspaceHomeSection.astro';
import SponsorRail from '@/components/sponsors/SponsorRail.astro';
import { getLocalizedCategories } from '@/data/categories';
import { getLocalizedTools } from '@/data/tools';
import { getMessages } from '@/i18n/messages';
import { localizePath, type Locale } from '@/i18n/config';
import styles from '@/pages/Home.module.css';

const { locale } = Astro.props as { locale: Locale };
const categories = getLocalizedCategories(locale);
const tools = getLocalizedTools(locale);
const m = getMessages(locale);
---
<HubLayout title={m.home.title} description={m.home.description} locale={locale}>
  <header class={styles.hero}>
    <div class:list={['container', styles.heroInner]}>
      <div class={styles.heroText}>
        <div class={styles.heroBadge}><span class={styles.heroBadgeDot}></span><span>{m.home.badge}</span></div>
        <h1 class={styles.heroTitle}>{m.home.heading}</h1>
        <p class={styles.heroCopy}>{m.home.intro}</p>
      </div>
      <div class={styles.heroSearch}><ToolSearch tools={tools} compact={true} locale={locale} /></div>
    </div>
  </header>
  <div class:list={['container', styles.workspace]}>
    <RecentTools tools={tools} locale={locale} />
    <WorkspaceHomeSection locale={locale} />
    <div class={styles.layout}>
      <div class={styles.libraryIsland}>
        <div class={styles.libraryHeader}>
          <div><h2 class={styles.libraryTitle}>{m.home.libraryTitle}</h2><p class={styles.librarySubtitle}>{m.home.libraryIntro}</p></div>
          <Button variant="secondary" href={localizePath('/tools/', locale)} iconTrailing="chevron-right">{m.home.fullDirectory}</Button>
        </div>
        <fieldset class={styles.categoryNav}>
          <legend class="sr-only">{m.home.categoryNav}</legend>
          <label class={styles.categoryTab}>
            <input type="radio" name="category-filter" value="all" checked class={styles.categoryInput} />
            <Icon class={styles.allIcon} name="layout-grid" />
            <span class={styles.tabName}>{m.home.allCategories}</span>
            <span class={styles.tabCount}>{tools.length}</span>
          </label>
          {categories.map((category) => { const count = tools.filter((tool) => tool.category === category.id).length; return <label class={styles.categoryTab}><input type="radio" name="category-filter" value={category.id} class={styles.categoryInput} /><ToolIcon category={category.id} /><span class={styles.tabName}>{category.name}</span><span class={styles.tabCount}>{count}</span></label>; })}
        </fieldset>
        <div class={styles.categoriesContent}>
          {categories.map((category) => { const categoryTools = tools.filter((tool) => tool.category === category.id).slice(0, 6); const count = tools.filter((tool) => tool.category === category.id).length; return <section class={styles.categorySection} id={category.id} data-category-section={category.id} aria-labelledby={`${category.id}-title`}><div class={styles.categoryHead}><div class={styles.categoryInfo}><h2 id={`${category.id}-title`} class={styles.categoryTitle}>{category.name}</h2><span class={styles.categoryCount}>({count} {m.common.tools})</span></div><a href={localizePath(`/${category.id}/`, locale)} class={styles.seeCategoryLink} aria-label={`${m.home.seeAllCategory} ${category.name}`}><span>{m.home.seeCategory}</span><span class="sr-only"> ({category.name})</span><Icon class={styles.linkChevron} name="chevron-right" /></a></div><div class={styles.toolGrid}>{categoryTools.map((tool) => <ToolCard tool={tool} locale={locale} />)}</div></section>; })}
        </div>
      </div>
      <div class={styles.sidebar}><SponsorRail locale={locale} /></div>
    </div>
  </div>
</HubLayout>
