---
import HubLayout from '@/layouts/HubLayout.astro';
import Icon from '@noduct/design-system/icons/Icon.astro';
import { getShellMessages } from '@noduct/design-system/shell/messages';
import ToolSearch from '@/components/tools/ToolSearch.astro';
import { getLocalizedTools } from '@/data/tools';
import { getMessages } from '@/i18n/messages';
import { localizePath, type Locale } from '@/i18n/config';

const { locale } = Astro.props as { locale: Locale };
const m = getMessages(locale);
const shellMessages = getShellMessages(locale);
const tools = getLocalizedTools(locale);
---

<HubLayout title={m.directory.title} description={m.directory.description} locale={locale}>
  <header class="page-head">
    <div class="container">
      <nav class="breadcrumb" aria-label={shellMessages.nav.breadcrumb}>
        <a class="breadcrumb-link" href={localizePath('/', locale)}>
          <Icon class="breadcrumb-icon" name="house" />
          <span>{shellMessages.nav.breadcrumbHome}</span>
        </a>
        <Icon class="breadcrumb-sep" name="chevron-right" />
        <span class="breadcrumb-current" aria-current="page">{m.directory.heading}</span>
      </nav>
      <p class="eyebrow">{m.directory.eyebrow}</p>
      <h1>{m.directory.heading}</h1>
      <p class="lede">{m.directory.intro}</p>
    </div>
  </header>
  <section class="section container">
    <ToolSearch tools={tools} showDirectory={true} locale={locale} />
  </section>
</HubLayout>
