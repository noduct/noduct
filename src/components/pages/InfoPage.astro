---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { siteConfig } from '@/config/site';
import { getMessages } from '@/i18n/messages';
import { localizePath, type Locale } from '@/i18n/config';
import Button from '@noduct/design-system/components/Button.astro';
type Kind = 'about' | 'contact' | 'privacy' | 'terms' | 'sponsor' | '404';
const { locale, kind } = Astro.props as { locale: Locale; kind: Kind };
const m = getMessages(locale); const configured = Boolean(siteConfig.contactUrl || siteConfig.contactEmail);
const page = kind === 'about' ? m.about : kind === 'contact' ? m.contact : kind === 'privacy' ? m.privacy : kind === 'terms' ? m.terms : kind === 'sponsor' ? m.sponsorPage : m.notFound;
---
<BaseLayout title={page.title} description={page.description} locale={locale} noindex={kind === '404'}>
  {kind === 'about' && <><header class="page-head"><div class="narrow"><p class="eyebrow">{m.about.eyebrow}</p><h1>{m.about.heading}</h1><p class="lede">{m.about.intro}</p></div></header><article class="section narrow prose">{m.about.sections.map((section) => <section><h2>{section.title}</h2>{section.body && <p>{section.body}</p>}{section.items && <ul>{section.items.map((item) => <li>{item}</li>)}</ul>}</section>)}</article></>}
  {kind === 'contact' && <><header class="page-head"><div class="narrow"><p class="eyebrow">{m.contact.eyebrow}</p><h1>{m.contact.heading}</h1><p class="lede">{m.contact.intro}</p></div></header><section class="section narrow">{configured ? <div class="grid"><p>{m.contact.guidance}</p>{siteConfig.contactUrl && <Button href={siteConfig.contactUrl}>{m.contact.form}</Button>}{siteConfig.contactEmail && <Button variant="secondary" href={`mailto:${siteConfig.contactEmail}`}>{m.contact.email}</Button>}</div> : <div class="surface empty"><strong>{m.contact.emptyTitle}</strong><p>{m.contact.emptyText}</p></div>}</section></>}
  {kind === 'privacy' && <><header class="page-head"><div class="narrow"><p class="eyebrow">{m.privacy.updated}</p><h1>{m.privacy.heading}</h1><p class="lede">{m.privacy.intro}</p></div></header><article class="section narrow prose">{m.privacy.sections.map((section) => <section><h2>{section.title}</h2><p>{section.body}</p></section>)}</article></>}
  {kind === 'terms' && <><header class="page-head"><div class="narrow"><p class="eyebrow">{m.terms.updated}</p><h1>{m.terms.heading}</h1><p class="lede">{m.terms.intro}</p></div></header><article class="section narrow prose">{m.terms.sections.map((section) => <section><h2>{section.title}</h2><p>{section.body}</p></section>)}</article></>}
  {kind === 'sponsor' && <><header class="page-head"><div class="narrow"><p class="eyebrow">{m.sponsorPage.eyebrow}</p><h1>{m.sponsorPage.heading}</h1><p class="lede">{m.sponsorPage.intro(siteConfig.sponsor.monthlyPriceUsd)}</p></div></header><section class="section narrow prose"><div class="prelaunch surface"><strong>{m.sponsorPage.noticeTitle}</strong><p>{m.sponsorPage.notice}</p></div><h2>{m.sponsorPage.includedTitle}</h2><ul>{m.sponsorPage.included.map((item) => <li>{item}</li>)}</ul><h2>{m.sponsorPage.priceTitle}</h2><p>{m.sponsorPage.price(siteConfig.sponsor.monthlyPriceUsd)}</p><h2>{m.sponsorPage.approvalTitle}</h2><ol>{m.sponsorPage.approval.map((item) => <li>{item}</li>)}</ol><h2>{m.sponsorPage.rulesTitle}</h2><p>{m.sponsorPage.rules}</p><h2>{m.sponsorPage.paymentsTitle}</h2><p>{m.sponsorPage.payments}</p><h2>{m.sponsorPage.contactTitle}</h2><p>{m.sponsorPage.contact}</p></section></>}
  {kind === '404' && <section class="section narrow not-found"><p class="eyebrow">{m.notFound.eyebrow}</p><h1>{m.notFound.heading}</h1><p class="lede">{m.notFound.intro}</p><div class="actions"><Button href={localizePath('/', locale)}>{m.notFound.home}</Button><Button variant="secondary" href={localizePath('/tools/', locale)}>{m.notFound.tools}</Button></div></section>}
</BaseLayout>
<style>.prelaunch{padding:1rem 1.25rem;border-left:4px solid var(--color-primary)}.prelaunch p{margin-top:.2rem}.not-found{min-height:55vh;display:grid;align-content:center}.actions{display:flex;flex-wrap:wrap;gap:.75rem;margin-top:1.5rem}</style>
