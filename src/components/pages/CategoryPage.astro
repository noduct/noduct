---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Icon from '@noduct/design-system/icons/Icon.astro';
import { getShellMessages } from '@noduct/design-system/shell/messages';
import ToolCard from '@/components/tools/ToolCard.astro';
import { getLocalizedCategories } from '@/data/categories';
import { getLocalizedTools } from '@/data/tools';
import { getMessages } from '@/i18n/messages';
import { localizePath, type Locale } from '@/i18n/config';
import type { ToolCategory } from '@/types/tool';
const { locale, categoryId } = Astro.props as { locale: Locale; categoryId: ToolCategory };
const m = getMessages(locale); const category = getLocalizedCategories(locale).find((item) => item.id === categoryId)!; const tools = getLocalizedTools(locale).filter((tool) => tool.category === categoryId);
const shellMessages = getShellMessages(locale);
---
<BaseLayout title={category.name} description={m.categoryPage.description(category.name, category.description)} locale={locale}>
  <header class="page-head">
    <div class="container">
      <nav class="breadcrumb" aria-label={shellMessages.nav.breadcrumb}>
        <a class="breadcrumb-link" href={localizePath('/', locale)}>
          <Icon class="breadcrumb-icon" name="house" />
          <span>{shellMessages.nav.breadcrumbHome}</span>
        </a>
        <Icon class="breadcrumb-sep" name="chevron-right" />
        <span class="breadcrumb-current" aria-current="page">{category.name}</span>
      </nav>

      <p class="eyebrow">{m.categoryPage.eyebrow}</p>
      <h1>{category.name}</h1>
      <p class="lede">{category.description}</p>
    </div>
  </header>

  <section class="section container">
    <div class="notice surface">
      <strong>{m.categoryPage.statusTitle}</strong>
      <p>{m.categoryPage.statusText}</p>
    </div>
    <h2 class="sr-only">{m.categoryPage.roadmapLabel(category.name)}</h2>
    <div class="grid grid-3 tool-grid">
      {tools.map((tool) => <ToolCard tool={tool} locale={locale} />)}
    </div>
  </section>
</BaseLayout>

<style>
  .notice {
    padding: 1.15rem 1.4rem;
    border-radius: var(--radius-md);
    border: 1px solid var(--color-border);
    box-shadow: var(--shadow-sm), var(--rim-light-subtle);
  }

  .notice strong {
    color: var(--color-text);
    font-size: .92rem;
  }

  .notice p {
    margin: .35rem 0 0;
    color: var(--color-text-secondary);
    font-size: .88rem;
    line-height: 1.5;
  }

  .tool-grid {
    margin-top: 1.75rem;
  }
</style>
