---
import { sponsorships } from '@/data/sponsorships';
import Icon from '@noduct/design-system/icons/Icon.astro';
import { activeSponsorFor } from '@/lib/sponsorships';
import { getMessages } from '@/i18n/messages';
import { localizePath, type Locale } from '@/i18n/config';
const { locale = 'en' } = Astro.props as { locale?: Locale };
const m = getMessages(locale);

const sponsors = ['home-rail-primary', 'home-rail-secondary']
  .map((placement) => activeSponsorFor(sponsorships, placement))
  .filter((sponsor) => sponsor !== undefined);
---

<aside class="rail" aria-label={m.sponsors.label}>
  <div class="rail-header">
    <p class="rail-title">{sponsors.length > 0 ? m.sponsors.partners : m.sponsors.sponsorship}</p>
  </div>

  {sponsors.map((sponsor) => (
    <a class="sponsor card" href={sponsor.destinationUrl} rel="sponsored noopener noreferrer" target="_blank">
      <div class="sponsor-top">
        <span class="badge">{m.sponsors.sponsored}</span>
        {sponsor.logoUrl && <img src={sponsor.logoUrl} alt="" width="28" height="28" loading="lazy" class="logo" />}
      </div>
      <strong>{sponsor.sponsorName}</strong>
      <span class="description">{sponsor.description}</span>
      <span class="action">
        <span>{m.sponsors.visit}</span>
        <Icon class="action-icon" name="arrow-up-right" />
        <span class="sr-only"> ({m.common.opensNewTab})</span>
      </span>
    </a>
  ))}

  <a class="advertise card" href={localizePath('/sponsor/', locale)}>
    <div class="sponsor-top">
      <span class="badge">{m.sponsors.placement}</span>
    </div>
    <strong>{m.sponsors.title}</strong>
    <span class="description">{m.sponsors.description}</span>
    <span class="action">
      <span>{m.sponsors.advertise}</span>
      <Icon class="action-icon" name="chevron-right" />
    </span>
  </a>
</aside>

<style>
  .rail {
    display: flex;
    flex-direction: column;
    gap: 12px;
    width: 100%;
  }

  .rail-header {
    display: flex;
    align-items: center;
    padding-bottom: 2px;
  }

  .rail-title {
    margin: 0;
    color: var(--color-text-secondary);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .sponsor,
  .advertise {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.5rem;
    width: 100%;
    padding: 1.25rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-surface-card);
    box-shadow: var(--shadow-sm), var(--rim-light);
    color: var(--color-text);
    text-decoration: none;
    transition:
      border-color var(--duration-fast) var(--ease-apple),
      background-color var(--duration-fast) var(--ease-apple),
      box-shadow var(--duration-fast) var(--ease-apple),
      transform var(--duration-fast) var(--ease-apple);
  }

  @media (hover: hover) and (pointer: fine) {
    .sponsor:hover,
    .advertise:hover {
      border-color: var(--color-border-strong);
      background: var(--color-surface-card);
      box-shadow: var(--shadow-card-hover), var(--rim-light);
      transform: translateY(-2px);
    }
  }

  .sponsor-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    gap: 0.5rem;
  }

  .badge {
    display: inline-flex;
    align-items: center;
    width: fit-content;
    padding: 0.2rem 0.5rem;
    border-radius: var(--radius-xs);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    color: var(--color-text-secondary);
    font-size: 0.65rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  strong {
    font-size: 0.92rem;
    font-weight: 650;
    line-height: 1.35;
    letter-spacing: -0.01em;
    color: var(--color-text);
  }

  .description {
    color: var(--color-text-secondary);
    font-size: 0.82rem;
    line-height: 1.5;
  }

  .action {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    margin-top: 0.25rem;
    color: var(--color-primary);
    font-size: 0.82rem;
    font-weight: 600;
    white-space: nowrap;
  }

  .action-icon {
    width: 14px;
    height: 14px;
    flex-shrink: 0;
    transition: transform var(--duration-fast) var(--ease-apple);
  }

  @media (hover: hover) and (pointer: fine) {
    .sponsor:hover .action-icon,
    .advertise:hover .action-icon {
      transform: translateX(2px);
    }
  }

  .logo {
    object-fit: contain;
    border-radius: var(--radius-xs);
  }

  @media (min-width: 1025px) {
    .rail {
      position: sticky;
      top: 72px;
    }
  }

  @media (max-width: 1024px) {
    .rail {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(min(280px, 100%), 1fr));
    }

    .rail-header {
      grid-column: 1 / -1;
    }
  }
</style>
