---
import SponsorshipSlot from '@noduct/design-system/components/SponsorshipSlot.astro';
import { sponsorshipRegistry } from '../../../sponsorship';
import { siteConfig } from '@/config/site';
import { topology } from '@noduct/tool-runtime';
import type { Locale } from '@/i18n/config';
const {
  placementId,
  locale = 'en',
  enabled = false
} = Astro.props as { placementId: string; locale?: Locale; enabled?: boolean };
const displayEnabled = enabled && siteConfig.sponsor.commercialMode !== 'prelaunch';
---

<SponsorshipSlot
  placementId={placementId}
  locale={locale}
  registry={sponsorshipRegistry}
  registryUrl={topology.registryUrl}
  enabled={displayEnabled}
/>
