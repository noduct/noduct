---
import { sponsorships } from '@/data/sponsorships';
import { activeSponsorFor } from '@/lib/sponsorships';
const { placementId } = Astro.props as { placementId: string };
const sponsor = activeSponsorFor(sponsorships, placementId);
---
{sponsor && <aside class="sponsor" aria-label="Sponsored content"><div><span>Sponsored</span><strong>{sponsor.sponsorName}</strong><p>{sponsor.description}</p></div><a href={sponsor.destinationUrl} rel="sponsored noopener noreferrer" target="_blank">Visit sponsor <span aria-hidden="true">↗</span><span class="sr-only"> (opens in a new tab)</span></a></aside>}
<style>
  .sponsor { display: flex; align-items: center; justify-content: space-between; gap: 1rem; min-height: 112px; margin-block: 2rem; padding: 1rem 1.25rem; border: 1px solid var(--color-border); border-radius: var(--radius-lg); }
  span:first-child { display: block; color: var(--color-text-secondary); font-size: .68rem; font-weight: 800; letter-spacing: .1em; text-transform: uppercase; }
  strong { display: block; margin-top: .2rem; } p { margin: 0; color: var(--color-text-secondary); }
  a { white-space: nowrap; font-weight: 700; }
  .sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0,0,0,0); }
  @media(max-width: 560px) { .sponsor { align-items: start; flex-direction: column; } }
</style>
