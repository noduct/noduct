---
import ToolCard from './ToolCard.astro';
import Button from '@noduct/design-system/components/Button.astro';
import type { ToolDefinition } from '@/types/tool';
import { getMessages } from '@/i18n/messages';
import type { Locale } from '@/i18n/config';

const { tools, locale = 'en' } = Astro.props as { tools: ToolDefinition[]; locale?: Locale };
const availableTools = tools.filter((tool) => tool.status !== 'planned' && tool.url);
const m = getMessages(locale);
---

<section class="recent" data-recent-section hidden aria-labelledby="recent-title">
  <div class="heading">
    <div>
      <p class="kicker">{m.recent.kicker}</p>
      <h2 id="recent-title" class="title">{m.recent.title}</h2>
    </div>
    <Button variant="danger-quiet" icon="trash-2" data-clear-recent>
      <span>{m.recent.clear}</span>
    </Button>
  </div>
  <div class="items" data-recent-items>
    {
      availableTools.map((tool) => (
        <div data-recent-tool={tool.id} hidden>
          <ToolCard tool={tool} locale={locale} />
        </div>
      ))
    }
  </div>
</section>

<style>
  .recent {
    margin-bottom: 28px;
    padding: 1.25rem;
    background: var(--color-surface-card);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-sm), var(--rim-light);
  }

  .heading {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    margin-bottom: 1rem;
    padding-bottom: 0.65rem;
    border-bottom: 1px solid var(--color-border-subtle);
  }

  .kicker {
    margin: 0;
    color: var(--color-text-secondary);
    font-size: 0.75rem;
    font-weight: 500;
  }

  .title {
    margin: 0.15rem 0 0;
    font-size: 1rem;
    font-weight: 600;
    color: var(--color-text);
  }

  .items {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 12px;
  }

  @media (max-width: 820px) {
    .items {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 560px) {
    .items {
      grid-template-columns: 1fr;
    }
  }
</style>
