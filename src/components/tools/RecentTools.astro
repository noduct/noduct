---
import ToolCard from './ToolCard.astro';
import type { ToolDefinition } from '@/types/tool';
import { getMessages } from '@/i18n/messages';
import type { Locale } from '@/i18n/config';

const { tools, locale = 'en' } = Astro.props as { tools: ToolDefinition[]; locale?: Locale };
const availableTools = tools.filter((tool) => tool.status !== 'planned' && tool.url);
const m = getMessages(locale);
---

<section class="recent" data-recent-section hidden aria-labelledby="recent-title">
  <div class="heading">
    <div>
      <p class="kicker">{m.recent.kicker}</p>
      <h2 id="recent-title" class="title">{m.recent.title}</h2>
    </div>
    <button type="button" data-clear-recent class="clear-btn">
      <svg class="clear-icon" viewBox="0 0 16 16" fill="none" aria-hidden="true">
        <path d="M3 4h10M6 4V2.5h4V4M5 4v9a1 1 0 0 0 1 1h4a1 1 0 0 0 1-1V4" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
      <span>{m.recent.clear}</span>
    </button>
  </div>
  <div class="items" data-recent-items>
    {availableTools.map((tool) => (
      <div data-recent-tool={tool.id} hidden>
        <ToolCard tool={tool} locale={locale} />
      </div>
    ))}
  </div>
</section>

<script>
  const section = document.querySelector<HTMLElement>('[data-recent-section]');
  const items = [...document.querySelectorAll<HTMLElement>('[data-recent-tool]')];

  const renderRecent = () => {
    let recent: string[] = [];
    try {
      recent = JSON.parse(localStorage.getItem('tolvira-recent-tools') ?? '[]');
    } catch {
      recent = [];
    }

    const ordered = recent
      .map((id) => items.find((item) => item.dataset.recentTool === id))
      .filter(Boolean)
      .slice(0, 3) as HTMLElement[];

    items.forEach((item) => {
      item.hidden = true;
    });

    ordered.forEach((item) => {
      item.hidden = false;
      item.parentElement?.append(item);
    });

    if (section) section.hidden = ordered.length === 0;
  };

  document.querySelector('[data-clear-recent]')?.addEventListener('click', () => {
    localStorage.removeItem('tolvira-recent-tools');
    renderRecent();
  });

  renderRecent();
</script>

<style>
  .recent {
    margin-bottom: 28px;
    padding: 1.25rem;
    background: var(--color-surface-card);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
  }

  .heading {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    margin-bottom: 1rem;
    padding-bottom: .65rem;
    border-bottom: 1px solid var(--color-border-subtle);
  }

  .kicker {
    margin: 0;
    color: var(--color-text-secondary);
    font-size: .75rem;
    font-weight: 500;
  }

  .title {
    margin: .15rem 0 0;
    font-size: 1rem;
    font-weight: 600;
    color: var(--color-text);
  }

  .clear-btn {
    display: inline-flex;
    align-items: center;
    gap: .35rem;
    padding: 4px 8px;
    border: 1px solid transparent;
    border-radius: var(--radius-xs);
    background: transparent;
    color: var(--color-text-secondary);
    font-size: .75rem;
    cursor: pointer;
    transition:
      color var(--duration-fast) var(--ease-apple),
      background-color var(--duration-fast) var(--ease-apple);
  }

  .clear-btn:hover {
    color: var(--color-error);
    background: color-mix(in srgb, var(--color-error) 8%, transparent);
  }

  .clear-icon {
    width: 13px;
    height: 13px;
  }

  .items {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 12px;
  }

  @media (max-width: 820px) {
    .items {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 560px) {
    .items {
      grid-template-columns: 1fr;
    }
  }
</style>
