---
import type { ToolCategory } from '@/types/tool';
import Icon from '@noduct/design-system/icons/Icon.astro';
import { categoryIcon } from '@noduct/design-system/icons/category';

const { category, label } = Astro.props as { category: ToolCategory; label?: string };
---

<span class="icon" data-category={category} aria-hidden={label ? undefined : 'true'} aria-label={label}>
  <Icon name={categoryIcon[category]} label={label} />
</span>

<style>
  .icon {
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    border-radius: var(--radius-sm);
    background: var(--color-surface);
    border: 1px solid var(--color-border-subtle);
    box-shadow: var(--rim-light-subtle);
    color: var(--color-primary);
    flex-shrink: 0;
    transition:
      background-color var(--duration-fast) var(--ease-apple),
      border-color var(--duration-fast) var(--ease-apple),
      color var(--duration-fast) var(--ease-apple);
  }

  .icon :global(svg) {
    width: 16px;
    height: 16px;
  }
</style>
