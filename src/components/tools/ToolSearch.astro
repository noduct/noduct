---
import ToolIcon from './ToolIcon.astro';
import Icon from '@noduct/design-system/icons/Icon.astro';
import ToolCard from './ToolCard.astro';
import { getCategory } from '@/data/categories';
import type { ToolDefinition } from '@/types/tool';
import { getMessages } from '@/i18n/messages';
import type { Locale } from '@/i18n/config';
import popover from '@noduct/design-system/shell/Popover.module.css';

interface Props {
  tools: ToolDefinition[];
  compact?: boolean;
  showDirectory?: boolean;
  locale?: Locale;
}

const { tools, compact = false, showDirectory = false, locale = 'en' } = Astro.props;
const m = getMessages(locale);
---

<div
  class="search"
  data-tool-search
  data-compact={compact ? 'true' : 'false'}
  data-one-result={m.search.oneResult}
  data-many-results={m.search.results}
>
  <div class="search-box">
    <label for="tool-search" class="sr-only">{m.search.label}</label>
    <div class="input-wrap">
      <Icon class="search-icon" name="search" />
      <input
        id="tool-search"
        type="search"
        placeholder={m.search.placeholder}
        autocomplete="off"
        spellcheck="false"
        role="combobox"
        aria-expanded="false"
        aria-autocomplete="list"
        aria-controls="search-dropdown-menu"
        aria-describedby="search-help search-status"
      />
      <kbd aria-hidden="true">{m.search.shortcut}</kbd>
    </div>
    <small id="search-help" class="sr-only">{m.search.help}</small>
    <p id="search-status" class="sr-status" role="status" aria-live="polite"></p>

    <!-- Menu Select Flutuante em Live Search (Padrão Popover + Inset Grouped) -->
    <div
      id="search-dropdown-menu"
      class:list={[popover.panel, 'search-dropdown']}
      data-dropdown
      hidden
    >
      <div class={popover.header}>
        <span class={popover.title}>{m.search.suggested}</span>
        <span class={popover.badge} data-count-badge>0 {m.search.results}</span>
      </div>

      <div class={popover.body}>
        <div class={popover.card}>
          <ul class="dropdown-list" role="listbox" data-dropdown-list></ul>

          <!-- Estado Vazio Dentro da Ilha do Dropdown -->
          <div class="dropdown-empty" data-empty hidden>
            <span class="empty-icon-box" aria-hidden="true">
              <Icon class="empty-icon" name="search-x" />
            </span>
            <p class="empty-title">{m.search.noResults}</p>
            <p class="empty-desc">{m.search.noResultsHelp}</p>
          </div>
        </div>
      </div>

      <!--
        Itens da busca em <template>: conteúdo inerte (fora do cálculo de estilo e layout) até o
        primeiro uso. Metade do DOM da página ficava aqui, escondida, em todo carregamento.
      -->
      <template data-dropdown-items>
        {
          tools.map((tool) => {
            const cat = getCategory(tool.category, locale);
            const url = tool.url ?? '';
            const isClickable = Boolean(tool.url);

            return (
              <li
                class="dropdown-item"
                role="option"
                data-search-item
                data-search={`${tool.name} ${tool.description} ${cat?.name ?? ''} ${tool.keywords.join(' ')}`}
                data-url={url}
                data-clickable={isClickable ? 'true' : 'false'}
                hidden
              >
                <a href={isClickable ? url : undefined} class="item-link" tabindex="-1">
                  <span class="item-icon-box" aria-hidden="true">
                    <ToolIcon category={tool.category} />
                  </span>
                  <div class="item-body">
                    <div class="item-head">
                      <span class="item-title">{tool.name}</span>
                      <span class="item-category">{cat?.name}</span>
                    </div>
                    <p class="item-desc">{tool.description}</p>
                  </div>
                  <div class="item-meta">
                    <span class:list={['status-tag', `status-${tool.status}`]}>
                      <span class="status-dot" />
                      <span>
                        {tool.status === 'published' || tool.status === 'ready'
                          ? m.common.open
                          : tool.status === 'beta'
                            ? m.common.beta
                            : m.common.planned}
                      </span>
                    </span>
                    {isClickable ? (
                      <Icon class="item-arrow" name="chevron-right" />
                    ) : (
                      <span class="roadmap-badge">{m.search.roadmap}</span>
                    )}
                  </div>
                </a>
              </li>
            );
          })
        }
      </template>
    </div>
  </div>

  <!-- Diretório estático quando renderizado em páginas completas (ex: /tools/) -->
  {
    showDirectory && (
      <div class="grid grid-3 directory-grid">
        {tools.map((tool) => (
          <ToolCard tool={tool} locale={locale} />
        ))}
      </div>
    )
  }
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-tool-search]').forEach((root) => {
    const input = root.querySelector<HTMLInputElement>('input[type="search"]');
    const dropdown = root.querySelector<HTMLElement>('[data-dropdown]');
    const list = root.querySelector<HTMLElement>('[data-dropdown-list]');
    const template = root.querySelector<HTMLTemplateElement>('template[data-dropdown-items]');
    let items: HTMLElement[] = [];

    // Monta os itens a partir do <template> só quando a busca é usada pela primeira vez.
    const ensureItems = () => {
      if (items.length || !list || !template) return;
      list.append(template.content.cloneNode(true));
      items = [...list.querySelectorAll<HTMLElement>('[data-search-item]')];
    };
    const empty = root.querySelector<HTMLElement>('[data-empty]');
    const countBadge = root.querySelector<HTMLElement>('[data-count-badge]');
    const status = root.querySelector<HTMLElement>('[role="status"]');

    let activeIndex = -1;

    const getVisibleItems = () => items.filter((item) => !item.hidden);

    const setActiveItem = (index: number) => {
      const visible = getVisibleItems();
      visible.forEach((item, i) => {
        if (i === index) {
          item.classList.add('is-active');
          item.setAttribute('aria-selected', 'true');
          item.scrollIntoView({ block: 'nearest' });
        } else {
          item.classList.remove('is-active');
          item.removeAttribute('aria-selected');
        }
      });
      activeIndex = index;
    };

    const openDropdown = () => {
      if (!dropdown) return;
      dropdown.hidden = false;
      input?.setAttribute('aria-expanded', 'true');
    };

    const closeDropdown = () => {
      if (!dropdown) return;
      dropdown.hidden = true;
      input?.setAttribute('aria-expanded', 'false');
      setActiveItem(-1);
    };

    const update = () => {
      ensureItems();
      const query = input?.value.trim().toLowerCase() ?? '';
      if (!query) {
        closeDropdown();
        if (status) status.textContent = '';
        return;
      }

      let count = 0;
      for (const item of items) {
        const text = (item.dataset.search ?? '').toLowerCase();
        const match = text.includes(query);
        item.hidden = !match;
        if (match) count++;
      }

      openDropdown();
      if (list) list.hidden = count === 0;
      if (empty) empty.hidden = count !== 0;
      const label = count === 1 ? root.dataset.oneResult : root.dataset.manyResults;
      if (countBadge) countBadge.textContent = `${count} ${label}`;
      if (status) status.textContent = query ? `${count} ${label}` : '';

      setActiveItem(count > 0 ? 0 : -1);
    };

    input?.addEventListener('input', update);
    input?.addEventListener('focus', () => {
      if (input.value.trim()) update();
    });

    // Fechar ao clicar fora
    document.addEventListener('click', (event) => {
      if (!root.contains(event.target as Node)) {
        closeDropdown();
      }
    });

    // Navegação via teclado (ArrowDown, ArrowUp, Enter, Esc)
    input?.addEventListener('keydown', (event) => {
      const visible = getVisibleItems();
      if (dropdown?.hidden) {
        if (event.key === 'ArrowDown' && input.value.trim()) {
          event.preventDefault();
          update();
        }
        return;
      }

      if (event.key === 'ArrowDown') {
        event.preventDefault();
        const next = activeIndex + 1 >= visible.length ? 0 : activeIndex + 1;
        setActiveItem(next);
      } else if (event.key === 'ArrowUp') {
        event.preventDefault();
        const prev = activeIndex - 1 < 0 ? visible.length - 1 : activeIndex - 1;
        setActiveItem(prev);
      } else if (event.key === 'Enter') {
        if (activeIndex >= 0 && activeIndex < visible.length) {
          event.preventDefault();
          const target = visible[activeIndex];
          const link = target?.querySelector<HTMLAnchorElement>('a');
          if (link && link.href) {
            window.location.href = link.href;
          }
        }
      } else if (event.key === 'Escape') {
        event.preventDefault();
        closeDropdown();
      }
    });

    // Atalho global Ctrl+K / Cmd+K
    document.addEventListener('keydown', (event) => {
      if ((event.ctrlKey || event.metaKey) && event.key.toLowerCase() === 'k') {
        event.preventDefault();
        input?.focus();
        if (input?.value.trim()) {
          openDropdown();
        }
      }
    });
  });
</script>

<style>
  .search {
    width: 100%;
  }

  /* Âncora isolada da barra de busca para que o popover nunca dependa da altura do directory-grid */
  .search-box {
    position: relative;
    width: 100%;
  }

  .input-wrap {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    height: 44px;
    padding: 0 0.75rem 0 1rem;
    background: var(--color-surface-card);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-sm), var(--rim-light);
    transition:
      border-color var(--duration-fast) var(--ease-apple),
      box-shadow var(--duration-fast) var(--ease-apple),
      background-color var(--duration-fast) var(--ease-apple);
  }

  @media (hover: hover) and (pointer: fine) {
    .input-wrap:hover:not(:focus-within) {
      border-color: var(--color-border-strong);
    }
  }

  /* Halo de foco ótico Apple na cápsula externa */
  .input-wrap:focus-within {
    border-color: var(--color-primary);
    box-shadow: var(--shadow-focus-ring), var(--shadow-md);
  }

  .search-icon {
    width: 18px;
    height: 18px;
    color: var(--color-text-muted);
    flex-shrink: 0;
    transition:
      color var(--duration-fast) var(--ease-apple),
      transform var(--duration-fast) var(--ease-apple);
  }

  .input-wrap:focus-within .search-icon {
    color: var(--color-primary);
    transform: scale(1.05);
  }

  /* Input 100% livre de bordas e anéis internos indesejados */
  input {
    width: 100%;
    height: 100%;
    border: 0 !important;
    outline: 0 !important;
    padding: 0;
    background: transparent;
    color: var(--color-text);
    font-size: 0.88rem;
    box-shadow: none !important;
    -webkit-appearance: none;
    appearance: none;
  }

  input:focus,
  input:focus-visible {
    outline: none !important;
    box-shadow: none !important;
    border: none !important;
    -webkit-box-shadow: none !important;
  }

  input::placeholder {
    color: var(--color-text-muted);
    transition: opacity var(--duration-fast) var(--ease-apple);
  }

  .input-wrap:focus-within input::placeholder {
    opacity: 0.65;
  }

  input::-webkit-search-cancel-button {
    cursor: pointer;
  }

  kbd {
    display: inline-flex;
    align-items: center;
    height: 22px;
    padding: 0 0.45rem;
    border: 1px solid var(--color-border);
    border-bottom-width: 2px;
    border-radius: var(--radius-xs);
    background: var(--color-surface-sunken);
    color: var(--color-text-secondary);
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    white-space: nowrap;
    user-select: none;
    box-shadow: var(--shadow-key), var(--rim-light);
  }

  /* Popover da busca: casca visual em Popover.module.css; aqui só posição e estrutura Inset Grouped */
  .search-dropdown {
    position: absolute;
    top: calc(100% + 8px);
    left: 0;
    right: 0;
    z-index: var(--z-search);
  }

  .search-dropdown[hidden] {
    display: none;
  }

  .dropdown-list {
    margin: 0;
    padding: 0;
    list-style: none;
    overflow-y: auto;
    overscroll-behavior: contain;
    max-height: 340px;
    display: flex;
    flex-direction: column;
    scrollbar-width: thin;
    scrollbar-color: var(--scrollbar-thumb) transparent;
  }

  .dropdown-list::-webkit-scrollbar {
    width: 6px;
  }

  .dropdown-list::-webkit-scrollbar-track {
    background: transparent;
  }

  .dropdown-list::-webkit-scrollbar-thumb {
    background-color: var(--scrollbar-thumb);
    border-radius: var(--radius-pill);
    border: 1px solid transparent;
    background-clip: padding-box;
  }

  .dropdown-list::-webkit-scrollbar-thumb:hover {
    background-color: var(--scrollbar-thumb-hover);
  }

  .dropdown-item {
    transition: background-color var(--duration-fast) var(--ease-apple);
  }

  /* Hairline divider apenas entre itens visíveis consecutivos dentro da ilha */
  .dropdown-item:not([hidden]) ~ .dropdown-item:not([hidden]) {
    border-top: 1px solid var(--color-border-subtle);
  }

  .dropdown-item.is-active,
  .dropdown-item:hover {
    background: var(--color-surface-hover);
  }

  .dropdown-item[data-clickable='false'] .item-link {
    cursor: default;
  }

  .item-link {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.65rem 0.85rem;
    text-decoration: none;
    color: inherit;
    cursor: pointer;
  }

  .item-icon-box {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .dropdown-item.is-active .item-icon-box :global(.icon),
  .dropdown-item:hover .item-icon-box :global(.icon) {
    background: var(--color-primary-soft);
    border-color: var(--color-primary-border-soft);
  }

  .item-body {
    flex: 1;
    min-width: 0;
  }

  .item-head {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    line-height: 1.25;
  }

  .item-title {
    margin: 0;
    font-size: 0.86rem;
    font-weight: 600;
    color: var(--color-text);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    transition: color var(--duration-fast) var(--ease-apple);
  }

  .dropdown-item[data-clickable='true'].is-active .item-title,
  .dropdown-item[data-clickable='true']:hover .item-title {
    color: var(--color-primary);
  }

  .item-category {
    font-size: 0.68rem;
    font-weight: 500;
    color: var(--color-text-secondary);
    padding: 0.08rem 0.4rem;
    background: var(--color-surface-sunken);
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--radius-xs);
    white-space: nowrap;
  }

  .item-desc {
    margin: 0.2rem 0 0;
    font-size: 0.76rem;
    color: var(--color-text-secondary);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .item-meta {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-shrink: 0;
  }

  /* Tags de Status Adequadas */
  .status-tag {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    font-size: 0.68rem;
    font-weight: 600;
    padding: 0.15rem 0.5rem;
    border-radius: var(--radius-pill);
    letter-spacing: 0.02em;
    white-space: nowrap;
  }

  .status-dot {
    width: 5px;
    height: 5px;
    border-radius: var(--radius-circle);
    background: currentColor;
  }

  .status-published,
  .status-ready {
    background: var(--color-success-soft);
    color: var(--color-success);
    border: 1px solid var(--color-success-border);
  }

  .status-beta {
    background: var(--color-warning-soft);
    color: var(--color-warning);
    border: 1px solid var(--color-warning-border);
  }

  .status-planned {
    background: var(--color-surface-sunken);
    color: var(--color-text-muted);
    border: 1px solid var(--color-border);
  }

  .roadmap-badge {
    font-size: 0.68rem;
    font-weight: 500;
    color: var(--color-text-muted);
  }

  .item-arrow {
    width: 14px;
    height: 14px;
    color: var(--color-text-muted);
    transition:
      transform var(--duration-fast) var(--ease-apple),
      color var(--duration-fast) var(--ease-apple);
  }

  .dropdown-item.is-active .item-arrow,
  .dropdown-item:hover .item-arrow {
    color: var(--color-primary);
    transform: translateX(2px);
  }

  /* Estado vazio dentro da ilha do dropdown */
  .dropdown-empty {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 2rem 1.25rem;
    text-align: center;
  }

  .empty-icon-box {
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    margin-bottom: 0.6rem;
    border-radius: var(--radius-sm);
    background: var(--color-surface-sunken);
    border: 1px solid var(--color-border-subtle);
    color: var(--color-text-muted);
  }

  .empty-icon {
    width: 18px;
    height: 18px;
  }

  .empty-title {
    margin: 0;
    font-size: 0.86rem;
    font-weight: 600;
    color: var(--color-text);
  }

  .empty-desc {
    margin: 0.25rem 0 0;
    font-size: 0.76rem;
    color: var(--color-text-secondary);
    max-width: 280px;
  }

  .directory-grid {
    margin-top: 2rem;
  }

  .sr-status {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
  }

  [hidden] {
    display: none !important;
  }

  @media (max-width: 620px) {
    kbd {
      display: none;
    }

    .roadmap-badge {
      display: none;
    }
  }
</style>
