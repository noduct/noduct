{
  "name": "noduct-workspace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && npm run validate:i18n && npm run validate:sponsorship-registry",
    "preview": "astro preview",
    "lint": "eslint .",
    "lint:styles": "stylelint \"src/**/*.{css,astro}\" \"packages/*/src/**/*.{css,astro}\"",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "astro check",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:test-fixtures": "astro build --root tests/fixtures/sponsorship-app",
    "dev:merge-pdf": "astro dev --root packages/merge-pdf",
    "build:merge-pdf": "astro build --root packages/merge-pdf",
    "build:pages": "npm run build && npm run build:merge-pdf && tsx scripts/assemble-pages.ts && npm run validate:pages && npm run validate:seo",
    "test:e2e": "npm run build:test-fixtures && npm run build:pages && playwright test",
    "test:lighthouse": "lhci autorun",
    "validate": "npm run lint && npm run typecheck && npm test && npm run validate:catalog && npm run check:sponsors && npm run build",
    "validate:catalog": "tsx scripts/validate-catalog.ts",
    "validate:seo": "tsx scripts/validate-seo.ts",
    "validate:pages": "tsx scripts/validate-pages.ts",
    "validate:ui": "tsx scripts/validate-ui.ts",
    "validate:architecture": "tsx scripts/validate-architecture.ts",
    "validate:i18n": "tsx scripts/validate-i18n.ts",
    "check:sponsors": "tsx scripts/validate-sponsors.ts",
    "validate:sponsorship-registry": "tsx scripts/validate-sponsorship-registry.ts",
    "github": "node scripts/github/manage.mjs"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.6.0",
    "astro": "^5.14.0",
    "pdf-lib": "1.17.1",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.0",
    "@axe-core/playwright": "^4.10.0",
    "@eslint/js": "^9.0.0",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.55.0",
    "@types/node": "^22.0.0",
    "esbuild": "^0.27.7",
    "eslint": "^9.0.0",
    "eslint-plugin-astro": "^1.3.0",
    "fake-indexeddb": "^6.2.6",
    "globals": "^16.0.0",
    "postcss-html": "2.0.0",
    "prettier": "^3.6.0",
    "prettier-plugin-astro": "^0.14.0",
    "sharp": "^0.34.5",
    "stylelint": "17.16.0",
    "stylelint-config-html": "2.0.0",
    "stylelint-declaration-strict-value": "1.12.1",
    "stylelint-value-no-unknown-custom-properties": "6.1.1",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^3.2.0"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
