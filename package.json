{
  "name": "noduct-workspace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "tsx scripts/noduct.ts dev",
    "build": "tsx scripts/noduct.ts build",
    "preview": "tsx scripts/noduct.ts preview",
    "check": "tsx scripts/noduct.ts check",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "tsx scripts/noduct.ts e2e",
    "verify": "tsx scripts/noduct.ts verify",
    "new:tool": "tsx scripts/noduct.ts new-tool",
    "format": "prettier --write .",
    "github": "node scripts/github/manage.mjs"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.6.0",
    "astro": "^5.14.0",
    "pdf-lib": "1.17.1",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.0",
    "@axe-core/playwright": "^4.10.0",
    "@eslint/js": "^9.0.0",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.55.0",
    "@types/node": "^22.0.0",
    "esbuild": "^0.27.7",
    "eslint": "^9.0.0",
    "eslint-plugin-astro": "^1.3.0",
    "fake-indexeddb": "^6.2.6",
    "globals": "^16.0.0",
    "postcss-html": "2.0.0",
    "prettier": "^3.6.0",
    "prettier-plugin-astro": "^0.14.0",
    "sharp": "^0.34.5",
    "stylelint": "17.16.0",
    "stylelint-config-html": "2.0.0",
    "stylelint-declaration-strict-value": "1.12.1",
    "stylelint-value-no-unknown-custom-properties": "6.1.1",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^3.2.0"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
